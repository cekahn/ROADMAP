### :00081  worst-group recall
:00081 a owl:Class ;
    rdfs:label "worst-group recall"@en ;
    skos:altLabel "worst-group outcome"@en ;
    skos:definition "Focuses on the minimum recall across all groups, prioritising improvement for the most disadvantaged group in line with minimax (Rawlsian) fairness."@en ;
    dcterms:source <https://doi.org/10.1145/3461702.3462523> ;
    :hasTargetValue "Max Recall" ;
    :hasGuidanceRationale "Linked to Rawls' Theory of Justice (maximise minimum benefit); sensitive to outlier subgroups."@en ;
    # true positive rate
    :hasRelatedMetric roadmap:03339 ;
    rdfs:subClassOf :00023 ,
        roadmap:03302 ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ,
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00089 ] ,
        [ a owl:Restriction ; owl:onProperty :hasPerformanceDependence ; owl:hasValue :00086 ] ,
        [ a owl:Restriction ; owl:onProperty :hasBiasPreservationProperty ; owl:hasValue :BiasPreservationProperty_Preserving ] ,
        [ a owl:Restriction ; owl:onProperty :hasMetricSubtype ; owl:hasValue :Partial ] ,
        [ a owl:Restriction ; owl:onProperty :hasAggregationOperator ; owl:hasValue :AggOp_Minimum ] ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessDirection ; owl:hasValue :FairnessDirection_Higher ] ,
        [ a owl:Restriction ; owl:onProperty :hasSupportedSensitiveAttributeType ; owl:hasValue :SensitiveAttributeType_MultiGroup ] ,
        [ a owl:Restriction ; owl:onProperty :hasGuidanceLevel ; owl:hasValue :UseWithCaution ] ,
        [ a owl:Restriction ; owl:onProperty :dependsOnPrevalence ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :proposedForHealthcare ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_DecisionThreshold ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] .

### :00082  xAUROC
:00082 a owl:Class ;
    rdfs:label "xAUROC"@en ;
    skos:altLabel "cross-AUC"@en ;
    skos:definition "The cross-area under the ROC curve captures group-level misranking disparities, measuring the probability that a randomly chosen positive instance from one group is ranked higher than a randomly chosen negative instance from another group."@en ;
    dcterms:source <https://papers.nips.cc/paper_files/paper/2019/hash/73e0f7487b8e5297182c5a711d20bf26-Abstract.html> ;
    :hasTargetValue "0.5" ;
    :hasGuidanceRationale "Insufficient knowledge/support; seldom used in healthcare."@en ;
    # area under the receiver operating characteristic curve
    :hasRelatedMetric roadmap:03314 ;
    rdfs:subClassOf :00023 ,
        roadmap:03302 ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ,
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00088 ] ,
        [ a owl:Restriction ; owl:onProperty :hasPerformanceDependence ; owl:hasValue :00086 ] ,
        [ a owl:Restriction ; owl:onProperty :hasBiasPreservationProperty ; owl:hasValue :BiasPreservationProperty_Preserving ] ,
        [ a owl:Restriction ; owl:onProperty :hasMetricSubtype ; owl:hasValue :Discrimination ] ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessDirection ; owl:hasValue :FairnessDirection_Bidirectional ] ,
        [ a owl:Restriction ; owl:onProperty :hasSupportedSensitiveAttributeType ; owl:hasValue :SensitiveAttributeType_Binary ] ,
        [ a owl:Restriction ; owl:onProperty :hasGuidanceLevel ; owl:hasValue :Inadvisable ] ,
        [ a owl:Restriction ; owl:onProperty :dependsOnPrevalence ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :proposedForHealthcare ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty roadmap:optimum ; owl:hasValue "0.5"^^xsd:decimal ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] .

### :00083  xAUROC disparity
:00083 a owl:Class ;
    rdfs:label "xAUROC disparity"@en ;
    skos:definition "Measures the difference in xAUROC values between two sensitive groups; antisymmetric, capturing the magnitude and direction of cross-group ranking disparities."@en ;
    dcterms:source <https://papers.nips.cc/paper_files/paper/2019/hash/73e0f7487b8e5297182c5a711d20bf26-Abstract.html> ;
    :hasTargetValue "0" ;
    :hasGuidanceRationale "Insufficient knowledge/support; seldom used in healthcare."@en ;
    # area under the receiver operating characteristic curve
    :hasRelatedMetric roadmap:03314 ;
    rdfs:subClassOf :00023 ,
        roadmap:03302 ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ,
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00088 ] ,
        [ a owl:Restriction ; owl:onProperty :hasPerformanceDependence ; owl:hasValue :00086 ] ,
        [ a owl:Restriction ; owl:onProperty :hasBiasPreservationProperty ; owl:hasValue :BiasPreservationProperty_Preserving ] ,
        [ a owl:Restriction ; owl:onProperty :hasMetricSubtype ; owl:hasValue :Discrimination ] ,
        [ a owl:Restriction ; owl:onProperty :hasAggregationOperator ; owl:hasValue :AggOp_AbsoluteDifference ] ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessDirection ; owl:hasValue :FairnessDirection_Lower ] ,
        [ a owl:Restriction ; owl:onProperty :hasSupportedSensitiveAttributeType ; owl:hasValue :SensitiveAttributeType_Binary ] ,
        [ a owl:Restriction ; owl:onProperty :hasGuidanceLevel ; owl:hasValue :Inadvisable ] ,
        [ a owl:Restriction ; owl:onProperty :dependsOnPrevalence ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :proposedForHealthcare ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty roadmap:optimum ; owl:hasValue "0"^^xsd:integer ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] .

##############################################################################
#    Open issues
##############################################################################

###  Recorded here so that consumers know what this release does NOT yet do:
###
###  1. :incompatibleWith and :shouldBePairedWith are annotation properties and their conditions
###     (unequal prevalence across groups; imperfect model) are not represented. They need an
###     n-ary reified Incompatibility pattern. :incompatibleWith is also sparsely populated
###     (3 assertions, all from equalised odds) relative to the known impossibility results.
###  2. Guidance levels are editorial judgements from a single appraisal. They are asserted here
###     as class restrictions and therefore cannot be versioned or attributed independently of the
###     ontology. They should move to a separate, dated recommendation resource.
###  3. Five of the 60 target values are not plain numbers ("range (e^-eps, e^eps)", "0 (< 0.2)",
###     "AUROC", "1 - prevalence", "Max Recall") and so have no roadmap:optimum restriction.
###  4. Local identifiers mix numeric (:00023), CamelCase (:GroupFairness) and delimited lowercase
###     (:performance-dependent_fairness_metric) forms. A single numeric scheme should be adopted.
###  5. Toolkit implementations are not pinned to library versions, and only 13 of the 60 fairness
###     metrics have one. Aequitas and fairmodels are declared but carry no implementations.
###  6. :supportsIntersectionalAnalysis is asserted only where true (3 metrics), whereas
###     :dependsOnPrevalence and :proposedForHealthcare are asserted for all 60 including false.
###     Absence therefore means "false" for two properties and "not recorded" for the third.
###  7. ROADMAP represents patient-descriptor values inconsistently: race / ethnicity values are
###     individuals, sex values and age groups are classes. Until this is regularised, an
###     intersectional attribute cannot reference an age band (see
###     :IntersectionalExample_ElderlyBlackWoman), and mappings between the two styles have to
###     use skos annotations rather than owl:sameAs.
###  8. CDCREC / SPD-15 codes are missing for ROADMAP's seven OMB 2024 combined race and
###     ethnicity values, and for roadmap:03431 unknown sex and roadmap:03440 sex not listed.
###  9. :loincQuestionCode is declared but unpopulated. Candidate values (LOINC 76689-9 for sex
###     assigned at birth, 76691-5 for gender identity, and the race and ethnicity question
###     codes) need to be verified against a current LOINC release before being asserted.
### 10. The gender identity value set is unresolved: the SNOMED CT set carried here and the
###     USCDI set named in roadmap:03432's comment are not the same set.
### 11. ROADMAP's other social determinant of health branches - disability (roadmap:03589),
###     economic stability (roadmap:03588), education access and quality (roadmap:03584), health
###     care access and quality (roadmap:03587), neighborhood and built environment
###     (roadmap:03585), social and community context (roadmap:03586) - have no values at all,
###     and this extension adds none. Insurance or payer status, primary language and rurality
###     are absent from both ontologies despite being common fairness axes in clinical work.
### 12. There is no measurement-result layer. Fairness results should be expressed as
###     roadmap:03808 model performance instances that carry a fairness metric plus the sensitive
###     attribute value defining the subgroup; the property to link a result to its subgroup does
###     not yet exist.
