##############################################################################
#    Extension axioms on ROADMAP base metrics
##############################################################################

###  These axioms are asserted by this extension on classes owned by ROADMAP. They replace the
###  16 duplicate ':StandardMetric' individuals of the previous release, which mirrored ROADMAP
###  metrics under local IRIs. Folding them in repairs the scoring-propriety link: every fairness
###  metric's :hasRelatedMetric now points at a ROADMAP class, and where that class is a base
###  metric it carries the propriety, evaluation level and input requirements directly.


### roadmap:03329  Brier score
roadmap:03329 rdfs:subClassOf :StandardMetric ,
                  [ a owl:Restriction ; owl:onProperty :hasScoringPropriety ; owl:hasValue :Propriety_Proper ] ,
                  [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00088 ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] .

### roadmap:03319  F1 score
roadmap:03319 rdfs:subClassOf :StandardMetric ,
                  [ a owl:Restriction ; owl:onProperty :hasScoringPropriety ; owl:hasValue :Propriety_Improper ] ,
                  [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00089 ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_DecisionThreshold ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] .

### roadmap:03547  Matthews correlation coefficient
roadmap:03547 rdfs:subClassOf :StandardMetric ,
                  [ a owl:Restriction ; owl:onProperty :hasScoringPropriety ; owl:hasValue :Propriety_Improper ] ,
                  [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00089 ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_DecisionThreshold ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] .

### roadmap:03307  accuracy
roadmap:03307 rdfs:subClassOf :StandardMetric ,
                  [ a owl:Restriction ; owl:onProperty :hasScoringPropriety ; owl:hasValue :Propriety_Improper ] ,
                  [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00089 ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_DecisionThreshold ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] ,
                  [ a owl:Restriction ; owl:onProperty :hasImplementation ; owl:hasValue :impl_AIF360_accuracy ] .

### roadmap:03508  area under the precision-recall curve
roadmap:03508 rdfs:subClassOf :StandardMetric ,
                  [ a owl:Restriction ; owl:onProperty :hasScoringPropriety ; owl:hasValue :Propriety_SemiProper ] ,
                  [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00088 ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] .

### roadmap:03314  area under the receiver operating characteristic curve
roadmap:03314 rdfs:subClassOf :StandardMetric ,
                  [ a owl:Restriction ; owl:onProperty :hasScoringPropriety ; owl:hasValue :Propriety_SemiProper ] ,
                  [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00088 ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] .

### roadmap:03308  balanced accuracy
roadmap:03308 rdfs:subClassOf :StandardMetric ,
                  [ a owl:Restriction ; owl:onProperty :hasScoringPropriety ; owl:hasValue :Propriety_Improper ] ,
                  [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00089 ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_DecisionThreshold ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] .

### roadmap:03332  expected calibration error
roadmap:03332 rdfs:subClassOf :StandardMetric ,
                  [ a owl:Restriction ; owl:onProperty :hasScoringPropriety ; owl:hasValue :Propriety_Proper ] ,
                  [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00088 ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
                  [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] .

