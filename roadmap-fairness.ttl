        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] .

### :00072  sAUROC
:00072 a owl:Class ;
    rdfs:label "sAUROC"@en ;
    skos:definition "Evaluates subgroup-specific false positive rates while computing the true positive rate over the whole population, capturing performance differences between subgroups."@en ;
    dcterms:source <https://doi.org/10.1016/j.ebiom.2024.105002> ;
    :hasTargetValue "0.5" ;
    :hasGuidanceRationale "Insufficient knowledge/support; seldom used in healthcare."@en ;
