##############################################################################
#    Fairness metrics
##############################################################################

### :00024  absolute calibration error parity
:00024 a owl:Class ;
    rdfs:label "absolute calibration error parity"@en ;
    skos:definition "Measures the difference in absolute calibration error between subgroups, quantifying disparities in overall calibration by assessing deviations from perfect calibration."@en ;
    dcterms:source <https://doi.org/10.1145/3531146.3533166> ;
    :hasTargetValue "0" ;
    :hasGuidanceRationale "Should be paired with a per-group calibration plot and a discrimination metric; criticised for sensitivity to calibration binning and for treating over-/under-estimation equally."@en ;
    # expected calibration error
    :hasRelatedMetric roadmap:03332 ;
    rdfs:subClassOf :00023 ,
        roadmap:03302 ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ,
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00088 ] ,
        [ a owl:Restriction ; owl:onProperty :hasPerformanceDependence ; owl:hasValue :00086 ] ,
        [ a owl:Restriction ; owl:onProperty :hasBiasPreservationProperty ; owl:hasValue :BiasPreservationProperty_Preserving ] ,
        [ a owl:Restriction ; owl:onProperty :hasMetricSubtype ; owl:hasValue :Calibration ] ,
        [ a owl:Restriction ; owl:onProperty :hasAggregationOperator ; owl:hasValue :AggOp_AbsoluteDifference ] ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessDirection ; owl:hasValue :FairnessDirection_Lower ] ,
        [ a owl:Restriction ; owl:onProperty :hasSupportedSensitiveAttributeType ; owl:hasValue :SensitiveAttributeType_Binary ] ,
        [ a owl:Restriction ; owl:onProperty :hasGuidanceLevel ; owl:hasValue :UseWithCaution ] ,
        [ a owl:Restriction ; owl:onProperty :dependsOnPrevalence ; owl:hasValue "true"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :proposedForHealthcare ; owl:hasValue "true"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty roadmap:optimum ; owl:hasValue "0"^^xsd:integer ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] .

### :00025  AUPRC parity
:00025 a owl:Class ;
    rdfs:label "AUPRC parity"@en ;
    skos:definition "Measures the difference in area under the precision-recall curve (AUPRC) between subgroups defined by the sensitive attribute."@en ;
    dcterms:source <https://doi.org/10.1145/3306618.3314278> ;
    :hasTargetValue "0" ;
    :hasGuidanceRationale "AUPRC is semi-proper and can be an explicitly discriminatory metric favouring higher-prevalence subgroups."@en ;
    # area under the precision-recall curve
    :hasRelatedMetric roadmap:03508 ;
    rdfs:subClassOf :00023 ,
        roadmap:03302 ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ,
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00088 ] ,
        [ a owl:Restriction ; owl:onProperty :hasPerformanceDependence ; owl:hasValue :00086 ] ,
        [ a owl:Restriction ; owl:onProperty :hasBiasPreservationProperty ; owl:hasValue :BiasPreservationProperty_Preserving ] ,
        [ a owl:Restriction ; owl:onProperty :hasMetricSubtype ; owl:hasValue :Discrimination ] ,
        [ a owl:Restriction ; owl:onProperty :hasAggregationOperator ; owl:hasValue :AggOp_AbsoluteDifference ] ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessDirection ; owl:hasValue :FairnessDirection_Lower ] ,
        [ a owl:Restriction ; owl:onProperty :hasSupportedSensitiveAttributeType ; owl:hasValue :SensitiveAttributeType_Binary ] ,
        [ a owl:Restriction ; owl:onProperty :hasGuidanceLevel ; owl:hasValue :Inadvisable ] ,
        [ a owl:Restriction ; owl:onProperty :dependsOnPrevalence ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :proposedForHealthcare ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty roadmap:optimum ; owl:hasValue "0"^^xsd:integer ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] .

### :00026  AUROC parity
:00026 a owl:Class ;
    rdfs:label "AUROC parity"@en ;
    skos:definition "Measures the difference in AUROC (discrimination) between subgroups defined by the sensitive attribute; a value of 0 indicates no difference in discrimination across groups."@en ;
    dcterms:source <https://doi.org/10.1145/3442188.3445879> ;
    :hasTargetValue "0" ;
    :hasGuidanceRationale "Recommended if paired with a calibration-related parity metric; AUROC alone only reflects discrimination."@en ;
    # area under the receiver operating characteristic curve
    :hasRelatedMetric roadmap:03314 ;
    # absolute calibration error parity
    :shouldBePairedWith :00024 ;
    # calibration-in-the-large parity
    :shouldBePairedWith :00033 ;
    # equal calibration
    :shouldBePairedWith :00044 ;
    # expected calibration error parity
    :shouldBePairedWith :00051 ;
    # well calibration
    :shouldBePairedWith :00080 ;
    rdfs:subClassOf :00023 ,
        roadmap:03302 ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ,
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00088 ] ,
        [ a owl:Restriction ; owl:onProperty :hasPerformanceDependence ; owl:hasValue :00086 ] ,
        [ a owl:Restriction ; owl:onProperty :hasBiasPreservationProperty ; owl:hasValue :BiasPreservationProperty_Preserving ] ,
        [ a owl:Restriction ; owl:onProperty :hasMetricSubtype ; owl:hasValue :Discrimination ] ,
        [ a owl:Restriction ; owl:onProperty :hasAggregationOperator ; owl:hasValue :AggOp_AbsoluteDifference ] ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessDirection ; owl:hasValue :FairnessDirection_Lower ] ,
        [ a owl:Restriction ; owl:onProperty :hasSupportedSensitiveAttributeType ; owl:hasValue :SensitiveAttributeType_Binary ] ,
        [ a owl:Restriction ; owl:onProperty :hasGuidanceLevel ; owl:hasValue :Recommended ] ,
        [ a owl:Restriction ; owl:onProperty :dependsOnPrevalence ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :proposedForHealthcare ; owl:hasValue "true"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty roadmap:optimum ; owl:hasValue "0"^^xsd:integer ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] .

### :00027  average disparity in equalised odds
:00027 a owl:Class ;
    rdfs:label "average disparity in equalised odds"@en ;
    skos:definition "Measures the average deviation from equalised odds by aggregating pairwise true-positive-rate and false-positive-rate differences across all subgroups defined by the sensitive attribute."@en ;
    dcterms:source <https://proceedings.mlr.press/v252/wang24a.html> ;
    :hasTargetValue "0" ;
    :hasGuidanceRationale "Unclear how quantities should be combined; incompatible with other metrics under differing prevalence."@en ;
    # equalized odds
    :hasRelatedMetric roadmap:03229 ;
    rdfs:subClassOf :00023 ,
        roadmap:03302 ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ,
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00089 ] ,
        [ a owl:Restriction ; owl:onProperty :hasPerformanceDependence ; owl:hasValue :00086 ] ,
