        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] ,
        [ a owl:Restriction ; owl:onProperty :hasImplementation ; owl:hasValue :impl_AIF360_error_rate_ratio ] .

### :00051  expected calibration error parity
:00051 a owl:Class ;
    rdfs:label "expected calibration error parity"@en ;
    skos:definition "Quantifies the difference in expected calibration error between groups defined by the sensitive attribute; 0 when the model is equally calibrated across groups."@en ;
    dcterms:source <https://doi.org/10.1101/2023.09.18.23295660> ;
    :hasTargetValue "0" ;
    :hasGuidanceRationale "Proper metric, but criticised for sensitivity to calibration binning and for treating over-/under-estimation equally."@en ;
    # expected calibration error
    :hasRelatedMetric roadmap:03332 ;
    rdfs:subClassOf :00023 ,
        roadmap:03302 ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ,
