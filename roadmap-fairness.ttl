        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] .

### :00041  differential fairness
:00041 a owl:Class ;
    rdfs:label "differential fairness"@en ;
    skos:definition "A hybrid intersectional measure of the similarity of model classification across combinations of sensitive attributes; the criterion holds when the likelihood of a prediction outcome is bounded within a specified range for all pairs of sensitive-attribute tuples."@en ;
    dcterms:source <https://doi.org/10.1109/ICDE48307.2020.00203> ;
    :hasTargetValue "range (e^−ϵ, e^ϵ)" ;
    :hasGuidanceRationale "No empirical evaluation or considerable validation in healthcare."@en ;
    # group fairness
    :hasRelatedMetric roadmap:03225 ;
    rdfs:subClassOf :00023 ,
        roadmap:03302 ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ,
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00089 ] ,
        [ a owl:Restriction ; owl:onProperty :hasPerformanceDependence ; owl:hasValue :00087 ] ,
        [ a owl:Restriction ; owl:onProperty :hasBiasPreservationProperty ; owl:hasValue :BiasPreservationProperty_Transforming ] ,
        [ a owl:Restriction ; owl:onProperty :hasAggregationOperator ; owl:hasValue :AggOp_LogRatio ] ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessDirection ; owl:hasValue :FairnessDirection_Bidirectional ] ,
        [ a owl:Restriction ; owl:onProperty :hasSupportedSensitiveAttributeType ; owl:hasValue :SensitiveAttributeType_MultiGroup ] ,
        [ a owl:Restriction ; owl:onProperty :hasGuidanceLevel ; owl:hasValue :Inadvisable ] ,
        [ a owl:Restriction ; owl:onProperty :dependsOnPrevalence ; owl:hasValue "true"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :proposedForHealthcare ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :supportsIntersectionalAnalysis ; owl:hasValue "true"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_DecisionThreshold ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] .

### :00042  disparate impact
:00042 a owl:Class ;
    rdfs:label "disparate impact"@en ;
    skos:definition "Quantifies the legal concept of disparate impact as the ratio of positive-prediction rates across groups, associated with the 80% (four-fifths) rule; considers only prediction-rate similarity and not the ground truth."@en ;
    dcterms:source <https://doi.org/10.1145/2783258.2783311> ;
    :hasTargetValue "0 (< 0.2)" ;
    :hasGuidanceRationale "Connected to US disparate impact law; the associated four-fifths rule is neither necessary nor sufficient for the legal standard."@en ;
    # demographic parity
    :hasRelatedMetric roadmap:03228 ;
    rdfs:subClassOf :00023 ,
        roadmap:03302 ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ,
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00089 ] ,
        [ a owl:Restriction ; owl:onProperty :hasPerformanceDependence ; owl:hasValue :00087 ] ,
        [ a owl:Restriction ; owl:onProperty :hasBiasPreservationProperty ; owl:hasValue :BiasPreservationProperty_Transforming ] ,
        [ a owl:Restriction ; owl:onProperty :hasAggregationOperator ; owl:hasValue :AggOp_Ratio ] ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessDirection ; owl:hasValue :FairnessDirection_Lower ] ,
        [ a owl:Restriction ; owl:onProperty :hasSupportedSensitiveAttributeType ; owl:hasValue :SensitiveAttributeType_Binary ] ,
        [ a owl:Restriction ; owl:onProperty :hasGuidanceLevel ; owl:hasValue :UseWithCaution ] ,
        [ a owl:Restriction ; owl:onProperty :dependsOnPrevalence ; owl:hasValue "true"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :proposedForHealthcare ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_DecisionThreshold ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] ,
        [ a owl:Restriction ; owl:onProperty :hasImplementation ; owl:hasValue :impl_AIF360_disparate_impact ] ,
        [ a owl:Restriction ; owl:onProperty :hasImplementation ; owl:hasValue :impl_Fairlearn_demographic_parity_ratio ] .

### :00043  earth mover’s distance for equivalent separation
:00043 a owl:Class ;
    rdfs:label "earth mover’s distance for equivalent separation"@en ;
    skos:definition "Uses the first Wasserstein (earth mover's) distance to quantify how far apart the distributions of estimated probabilities are between sensitive groups within each outcome stratum, enforcing a separation criterion across all thresholds."@en ;
    dcterms:source <https://doi.org/10.1145/3306618.3314278> ;
    :hasTargetValue "0" ;
    :hasGuidanceRationale "Conceptually informative (satisfies separation criterion strongly), but not empirically evaluated."@en ;
    # earth mover's distance
    :hasRelatedMetric roadmap:04033 ;
    rdfs:subClassOf :00023 ,
        roadmap:03302 ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ,
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00088 ] ,
        [ a owl:Restriction ; owl:onProperty :hasPerformanceDependence ; owl:hasValue :00086 ] ,
        [ a owl:Restriction ; owl:onProperty :hasBiasPreservationProperty ; owl:hasValue :BiasPreservationProperty_Preserving ] ,
        [ a owl:Restriction ; owl:onProperty :hasMetricSubtype ; owl:hasValue :Overall ] ,
        [ a owl:Restriction ; owl:onProperty :hasAggregationOperator ; owl:hasValue :AggOp_WassersteinDistance ] ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessDirection ; owl:hasValue :FairnessDirection_Lower ] ,
        [ a owl:Restriction ; owl:onProperty :hasSupportedSensitiveAttributeType ; owl:hasValue :SensitiveAttributeType_MultiGroup ] ,
        [ a owl:Restriction ; owl:onProperty :hasGuidanceLevel ; owl:hasValue :UseWithCaution ] ,
        [ a owl:Restriction ; owl:onProperty :dependsOnPrevalence ; owl:hasValue "true"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :proposedForHealthcare ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty roadmap:optimum ; owl:hasValue "0"^^xsd:integer ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] .

### :00044  equal calibration
:00044 a owl:Class ;
    rdfs:label "equal calibration"@en ;
    skos:altLabel "matching conditional frequencies"@en ;
    skos:altLabel "test-fairness"@en ;
    skos:definition "Also known as test-fairness or matching conditional frequencies; requires that, for any estimated probability value, groups have similar positivity rates in the ground truth."@en ;
    dcterms:source <https://doi.org/10.48550/arXiv.1609.05807> ;
    :hasTargetValue "0" ;
    :hasGuidanceRationale "Unclear how to operationalise across thresholds; satisfying equal calibration is in principle desirable."@en ;
    # calibration-in-the-large
    :hasRelatedMetric roadmap:03655 ;
    rdfs:subClassOf :00023 ,
        roadmap:03302 ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ,
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00088 ] ,
        [ a owl:Restriction ; owl:onProperty :hasPerformanceDependence ; owl:hasValue :00086 ] ,
        [ a owl:Restriction ; owl:onProperty :hasBiasPreservationProperty ; owl:hasValue :BiasPreservationProperty_Preserving ] ,
        [ a owl:Restriction ; owl:onProperty :hasMetricSubtype ; owl:hasValue :Calibration ] ,
        [ a owl:Restriction ; owl:onProperty :hasAggregationOperator ; owl:hasValue :AggOp_AbsoluteDifference ] ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessDirection ; owl:hasValue :FairnessDirection_Lower ] ,
        [ a owl:Restriction ; owl:onProperty :hasSupportedSensitiveAttributeType ; owl:hasValue :SensitiveAttributeType_Binary ] ,
        [ a owl:Restriction ; owl:onProperty :hasGuidanceLevel ; owl:hasValue :UseWithCaution ] ,
        [ a owl:Restriction ; owl:onProperty :dependsOnPrevalence ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :proposedForHealthcare ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty roadmap:optimum ; owl:hasValue "0"^^xsd:integer ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] .

### :00045  equal opportunity difference
:00045 a owl:Class ;
    rdfs:label "equal opportunity difference"@en ;
    skos:altLabel "false negative error rate balance"@en ;
    skos:altLabel "recall parity"@en ;
    skos:definition "Also known as recall parity or false-negative-error-rate balance; requires that true positive rates are similar across groups, so individuals with a positive outcome are equally likely to receive a positive prediction."@en ;
    dcterms:source <https://proceedings.neurips.cc/paper/2016/hash/9d2682367c3935defcb1f9e247a97c0d-Abstract.html> ;
    :hasTargetValue "0" ;
    :hasGuidanceRationale "Aims for TPR parity; easily interpreted, but reliance on a possibly arbitrary threshold restricts standalone use."@en ;
    # predictive equality
    :shouldBePairedWith :00063 ;
    # recall equality difference
    :shouldBePairedWith :00068 ;
    # equality of opportunity
    skos:exactMatch roadmap:03227 ;
    rdfs:comment "Equivalence to equality of opportunity is deliberately withheld: recall equality difference also maps to it, and the two differ in aggregation operator and supported sensitive-attribute type, so owl:equivalentClass would make them equivalent to each other."@en ;
    rdfs:subClassOf :00023 ,
        roadmap:03302 ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ,
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00089 ] ,
        [ a owl:Restriction ; owl:onProperty :hasPerformanceDependence ; owl:hasValue :00086 ] ,
        [ a owl:Restriction ; owl:onProperty :hasBiasPreservationProperty ; owl:hasValue :BiasPreservationProperty_Preserving ] ,
        [ a owl:Restriction ; owl:onProperty :hasMetricSubtype ; owl:hasValue :Partial ] ,
        [ a owl:Restriction ; owl:onProperty :hasAggregationOperator ; owl:hasValue :AggOp_AbsoluteDifference ] ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessDirection ; owl:hasValue :FairnessDirection_Lower ] ,
        [ a owl:Restriction ; owl:onProperty :hasSupportedSensitiveAttributeType ; owl:hasValue :SensitiveAttributeType_Binary ] ,
        [ a owl:Restriction ; owl:onProperty :hasGuidanceLevel ; owl:hasValue :UseWithCaution ] ,
        [ a owl:Restriction ; owl:onProperty :dependsOnPrevalence ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :proposedForHealthcare ; owl:hasValue "true"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty roadmap:optimum ; owl:hasValue "0"^^xsd:integer ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_DecisionThreshold ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] ,
        [ a owl:Restriction ; owl:onProperty :hasImplementation ; owl:hasValue :impl_AIF360_equal_opportunity_difference ] .

### :00046  equalised odds
:00046 a owl:Class ;
    rdfs:label "equalised odds"@en ;
    skos:altLabel "conditional procedure accuracy equality"@en ;
    skos:altLabel "disparate mistreatment"@en ;
    skos:definition "Combines equal opportunity (true positive rates) and predictive equality (false positive rates), requiring both to be similar across groups."@en ;
    dcterms:source <https://proceedings.neurips.cc/paper/2016/hash/9d2682367c3935defcb1f9e247a97c0d-Abstract.html> ;
    :hasTargetValue "0" ;
    :hasGuidanceRationale "Combining TPR and FPR makes the metric lose focus, hampering interpretation."@en ;
    # equal calibration
    :incompatibleWith :00044 ;
    # predictive parity
    :incompatibleWith :00064 ;
    # well calibration
    :incompatibleWith :00080 ;
    # equalized odds
    skos:exactMatch roadmap:03229 ;
    owl:equivalentClass roadmap:03229 ;
    rdfs:subClassOf :00023 ,
        roadmap:03302 ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ,
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00089 ] ,
        [ a owl:Restriction ; owl:onProperty :hasPerformanceDependence ; owl:hasValue :00086 ] ,
        [ a owl:Restriction ; owl:onProperty :hasBiasPreservationProperty ; owl:hasValue :BiasPreservationProperty_Preserving ] ,
        [ a owl:Restriction ; owl:onProperty :hasMetricSubtype ; owl:hasValue :Partial ] ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessDirection ; owl:hasValue :FairnessDirection_Lower ] ,
        [ a owl:Restriction ; owl:onProperty :hasSupportedSensitiveAttributeType ; owl:hasValue :SensitiveAttributeType_Binary ] ,
        [ a owl:Restriction ; owl:onProperty :hasGuidanceLevel ; owl:hasValue :Inadvisable ] ,
        [ a owl:Restriction ; owl:onProperty :dependsOnPrevalence ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :proposedForHealthcare ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty roadmap:optimum ; owl:hasValue "0"^^xsd:integer ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_DecisionThreshold ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] ,
        [ a owl:Restriction ; owl:onProperty :hasImplementation ; owl:hasValue :impl_AIF360_average_abs_odds_difference ] ,
        [ a owl:Restriction ; owl:onProperty :hasImplementation ; owl:hasValue :impl_Fairlearn_equalized_odds_difference ] .

### :00047  equalising disincentives
:00047 a owl:Class ;
    rdfs:label "equalising disincentives"@en ;
