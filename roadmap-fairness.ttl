        [ a owl:Restriction ; owl:onProperty :hasBiasPreservationProperty ; owl:hasValue :BiasPreservationProperty_Preserving ] ,
        [ a owl:Restriction ; owl:onProperty :hasMetricSubtype ; owl:hasValue :Calibration ] ,
        [ a owl:Restriction ; owl:onProperty :hasAggregationOperator ; owl:hasValue :AggOp_AbsoluteDifference ] ,
