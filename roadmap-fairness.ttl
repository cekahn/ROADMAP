### :00068  recall equality difference
:00068 a owl:Class ;
    rdfs:label "recall equality difference"@en ;
    skos:definition "Measures the average absolute difference in recall (true positive rate) between each group and the overall recall; a multi-group extension of the equal opportunity difference."@en ;
    dcterms:source <https://doi.org/10.1145/3593013.3593982> ;
    :hasTargetValue "0" ;
    :hasGuidanceRationale "Same considerations as equal opportunity difference."@en ;
    # equality of opportunity
    skos:exactMatch roadmap:03227 ;
    rdfs:comment "Equivalence to equality of opportunity is deliberately withheld: equal opportunity difference also maps to it, and the two differ in aggregation operator and supported sensitive-attribute type, so owl:equivalentClass would make them equivalent to each other."@en ;
    rdfs:subClassOf :00023 ,
        roadmap:03302 ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ,
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00089 ] ,
        [ a owl:Restriction ; owl:onProperty :hasPerformanceDependence ; owl:hasValue :00086 ] ,
        [ a owl:Restriction ; owl:onProperty :hasBiasPreservationProperty ; owl:hasValue :BiasPreservationProperty_Preserving ] ,
        [ a owl:Restriction ; owl:onProperty :hasMetricSubtype ; owl:hasValue :Partial ] ,
        [ a owl:Restriction ; owl:onProperty :hasAggregationOperator ; owl:hasValue :AggOp_Mean ] ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessDirection ; owl:hasValue :FairnessDirection_Lower ] ,
        [ a owl:Restriction ; owl:onProperty :hasSupportedSensitiveAttributeType ; owl:hasValue :SensitiveAttributeType_MultiGroup ] ,
        [ a owl:Restriction ; owl:onProperty :hasGuidanceLevel ; owl:hasValue :UseWithCaution ] ,
        [ a owl:Restriction ; owl:onProperty :dependsOnPrevalence ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty :proposedForHealthcare ; owl:hasValue "true"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty roadmap:optimum ; owl:hasValue "0"^^xsd:integer ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_DecisionThreshold ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] .

