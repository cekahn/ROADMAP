@prefix : <https://rsna.org/roadmap/fairness/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix roadmap: <https://rsna.org/roadmap/> .
@base <https://rsna.org/roadmap/fairness/> .

<https://rsna.org/roadmap/fairness/> rdf:type owl:Ontology ;
    owl:versionIRI <https://rsna.org/roadmap/fairness/releases/2026-09/> ;
    owl:imports <https://rsna.org/roadmap/> ;
    dcterms:title "ROADMAP Fairness Metrics Extension" ;
    dcterms:description """An extension of the ROADMAP Ontology of AI Datasets, Models and Projects that describes fairness metrics for clinical prediction models. The extension characterises each metric by the notion of fairness it operationalises, the model behaviour or performance it compares, the inputs it requires, the aggregation operator it applies across groups, the value that represents perfect fairness, and an appraisal of its suitability for clinical use. It also provides a value set of sensitive attributes grounded in CDCREC, SNOMED CT and USCDI, and links metrics to implementations in open-source fairness toolkits. Fairness metrics are modelled as subclasses of ROADMAP fairness metric (roadmap:01043) and ROADMAP scalar metric (roadmap:03302) so that they can be used wherever a ROADMAP performance metric is used, including in roadmap:03808 model performance descriptions."""@en ;
    dcterms:license <https://creativecommons.org/licenses/by-nc-nd/4.0/> ;
    dcterms:publisher <https://rsna.org/> ,
                      "Radiological Society of North America"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ,
                   <https://doi.org/10.17605/OSF.IO/Z83ND> ,
                   <https://doi.org/10.1148/ryai.260069> ,
                   <https://doi.org/10.1148/ryai.260070> ;
    dcterms:modified "2026-09-14T00:00:00Z" ;
    rdfs:seeAlso <https://bioportal.bioontology.org/ontologies/ROADMAP> ;
    owl:versionInfo "2026-09" ;
    rdfs:comment """Namespace note: this ontology was previously published under the base IRI https://gamuts.net/fairness-metrics/. Local identifiers are unchanged; only the namespace has moved. Consumers of the earlier release should rewrite that prefix to https://rsna.org/roadmap/fairness/."""@en .

##############################################################################
#    Annotation properties
##############################################################################

dcterms:description rdf:type owl:AnnotationProperty .

dcterms:license rdf:type owl:AnnotationProperty .

dcterms:modified rdf:type owl:AnnotationProperty .

dcterms:publisher rdf:type owl:AnnotationProperty .

dcterms:source rdf:type owl:AnnotationProperty .

dcterms:title rdf:type owl:AnnotationProperty .

rdfs:comment rdf:type owl:AnnotationProperty .

rdfs:isDefinedBy rdf:type owl:AnnotationProperty .

rdfs:label rdf:type owl:AnnotationProperty .

rdfs:seeAlso rdf:type owl:AnnotationProperty .

skos:altLabel rdf:type owl:AnnotationProperty .

skos:closeMatch rdf:type owl:AnnotationProperty .

skos:definition rdf:type owl:AnnotationProperty .

skos:exactMatch rdf:type owl:AnnotationProperty .

skos:relatedMatch rdf:type owl:AnnotationProperty .


###  Type-level relations between metrics.
###  These hold between kinds of metric rather than between particular measurements, and in the
###  case of :incompatibleWith they hold only under stated conditions, so they are annotation
###  properties rather than object properties. See the ontology's open-issues note.

:hasRelatedMetric rdf:type owl:AnnotationProperty ;
    rdfs:label "has related metric"@en ;
    rdfs:comment "Links a fairness metric to the ROADMAP performance metric it operationalises, extends, or is computed from. For a fairness metric identical to a ROADMAP concept, skos:exactMatch (and, where the mapping is one-to-one, owl:equivalentClass) is used instead."@en .

:incompatibleWith rdf:type owl:AnnotationProperty ;
    rdfs:label "incompatible with"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    rdfs:comment "Indicates that two fairness metrics cannot in general be satisfied simultaneously (mutual-satisfiability / impossibility results). These incompatibilities are CONDITIONAL: they hold when outcome prevalence differs across the groups defined by the sensitive attribute and the model is not perfectly accurate. The conditions are not yet representable; see the open-issues note. Sources: Kleinberg et al. 2016; Chouldechova 2017."@en .

:shouldBePairedWith rdf:type owl:AnnotationProperty ;
    rdfs:label "should be paired with"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    rdfs:comment "Indicates that two fairness metrics should be reported together to be interpretable, per the cited critical appraisal (e.g. a discrimination metric paired with a calibration metric)."@en .

:hasParentMetric rdf:type owl:AnnotationProperty ;
    rdfs:label "has parent metric"@en ;
    rdfs:comment "Links a fairness metric to the fairness metric it specialises."@en .

:hasTargetValue rdf:type owl:AnnotationProperty ;
    rdfs:label "has target value"@en ;
    rdfs:comment "The value representing perfect fairness, as reported in the source catalogue, in human-readable form. Targets are heterogeneous (0, 1, 0.5, a range, or a reference to another quantity such as the overall AUROC or 1 - prevalence), so this is a string. Where the target is a plain number it is ALSO asserted as a roadmap:optimum restriction on the metric class, which is the machine-actionable form."@en .

:hasGuidanceRationale rdf:type owl:AnnotationProperty ;
    rdfs:label "has guidance rationale"@en ;
    rdfs:comment "The reasoning behind the guidance level, as given in the cited appraisal."@en .

##############################################################################
#    Object properties
##############################################################################

:combinesAttribute rdf:type owl:ObjectProperty ;
    rdfs:label "combines attribute"@en ;
    rdfs:comment "Links an intersectional sensitive attribute to each base sensitive-attribute value it combines (e.g. a 'Black women' subgroup combines the race value 'Black or African American' and the gender value 'identifies as female gender'). Values are individuals of the axis subclasses and hence of SensitiveAttribute."@en ;
    rdfs:domain :IntersectionalSensitiveAttribute ;
    rdfs:range :SensitiveAttribute .

:hasAggregationOperator rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has aggregation operator"@en ;
    dcterms:source <https://doi.org/10.17605/OSF.IO/Z83ND> ;
    rdfs:comment "The primary operator the fairness metric applies to its base metric across groups. Left unset for metrics that are novel cross-group constructions (e.g. xAUROC, sAUROC, pairwise ranking fairness, equity-scaled metrics) or that combine two sub-metrics via a reported design choice of max/mean (e.g. equalised odds, conditional use accuracy equality), and for subgroup net benefit, which is reported per subgroup rather than reduced by a fixed operator."@en ;
    rdfs:domain :00023 ;
    rdfs:range :AggregationOperator .

:hasBiasPreservationProperty rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has bias preservation property"@en ;
    dcterms:source <https://doi.org/10.2139/ssrn.3792772> ;
    rdfs:comment "Whether the metric is bias-preserving or bias-transforming, per Wachter, Mittelstadt & Russell (2021) as applied in the source catalogue."@en ;
    rdfs:domain :00023 ;
    rdfs:range :BiasPreservationProperty .

:hasEvaluationLevel rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has evaluation level"@en ;
    rdfs:domain roadmap:03642 ;
    rdfs:range :EvaluationLevel .

:hasFairnessDirection rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has fairness direction"@en ;
    dcterms:source <https://doi.org/10.17605/OSF.IO/Z83ND> ;
    rdfs:comment "The direction the metric value takes as fairness improves toward its target."@en ;
    rdfs:domain :00023 ;
    rdfs:range :FairnessDirection .

:hasFairnessLevel rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has fairness level"@en ;
    rdfs:domain :00023 ;
    rdfs:range :FairnessLevel .

:hasGuidanceLevel rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has guidance level"@en ;
    rdfs:domain :00023 ;
    rdfs:range :GuidanceLevel .

:hasImplementation rdf:type owl:ObjectProperty ;
    rdfs:label "has implementation"@en ;
    rdfs:comment "Links a metric to a concrete function/method in a fairness toolkit. Function names for AIF360 (ClassificationMetric) and Fairlearn (fairlearn.metrics) were verified against current documentation; note that a toolkit function may compute the complement of the named metric (e.g. false-omission-rate difference for NPV difference, since NPV = 1 - FOR). This layer is a starting scaffold and should be pinned to specific toolkit versions and extended (e.g. Aequitas, fairmodels) as needed."@en ;
    rdfs:domain roadmap:03642 ;
    rdfs:range :MetricImplementation .

:hasMetricSubtype rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has metric subtype"@en ;
    rdfs:comment "Only applicable to metrics for which hasPerformanceDependence = performance-dependent (00086); performance-independent metrics do not have a metric subtype in this taxonomy."@en ;
    rdfs:domain roadmap:03642 ;
    rdfs:range :MetricSubtype .

:hasPerformanceDependence rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has performance dependence"@en ;
    rdfs:domain :00023 ;
    rdfs:range :00085 .

:hasScoringPropriety rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has scoring propriety"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    rdfs:comment "The scoring-rule propriety of a (base) performance metric. Asserted on the standard metrics; fairness metrics inherit it via hasRelatedMetric. Proper and semi-proper are stated explicitly in the review for Brier score, expected calibration error, AUROC, and AUPRC; the threshold-dependent classification metrics are improper as scoring rules per the cited guidance (Van Calster et al. 2025)."@en ;
    rdfs:domain roadmap:03642 ;
    rdfs:range :ScoringPropriety .

:hasSupportedSensitiveAttributeType rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has supported sensitive attribute type"@en ;
    dcterms:source <https://doi.org/10.17605/OSF.IO/Z83ND> ;
    rdfs:comment "The cardinality of sensitive attribute the metric supports, as reported in the source catalogue. Values are broadly nested (continuous > multi-group > binary), but only the level stated in the catalogue is asserted here."@en ;
    rdfs:domain :00023 ;
    rdfs:range :SensitiveAttributeType .

:inCodeSystem rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "in code system"@en ;
    rdfs:range :CodeSystem .

:providedByToolkit rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "provided by toolkit"@en ;
    rdfs:domain :MetricImplementation ;
    rdfs:range :SoftwareToolkit .

:requiresInput rdf:type owl:ObjectProperty ;
    rdfs:label "requires input"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    rdfs:comment "The quantities/parameters a metric needs to be computed. Non-functional: most metrics require several inputs. Base inputs follow from the metric's performance-dependence and evaluation level (per the review's decision diagram); additional inputs (legitimate features, time-to-event, censoring, utility weight, historical outcome data) are asserted per metric."@en ;
    rdfs:domain roadmap:03642 ;
    rdfs:range :MetricInput .

##############################################################################
#    Data properties
##############################################################################

:code rdf:type owl:DatatypeProperty ;
    rdfs:label "code"@en ;
    rdfs:comment "The code for a value within its code system (see inCodeSystem)."@en ;
    rdfs:range xsd:string .

:dependsOnPrevalence rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depends on prevalence"@en ;
    rdfs:comment "Whether the metric's value depends on the base outcome prevalence within each sensitive-attribute group."@en ;
    rdfs:domain :00023 ;
    rdfs:range xsd:boolean .

:functionName rdf:type owl:DatatypeProperty ;
    rdfs:label "function name"@en ;
    rdfs:domain :MetricImplementation ;
    rdfs:range xsd:string .

:loincQuestionCode rdf:type owl:DatatypeProperty ;
    rdfs:label "LOINC question code"@en ;
    rdfs:comment "The LOINC code for the observation/question that captures this attribute (the coded answer values come from CDCREC/SNOMED, not LOINC)."@en ;
    rdfs:domain :SensitiveAttribute ;
    rdfs:range xsd:string .

:proposedForHealthcare rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "proposed for healthcare"@en ;
    rdfs:domain :00023 ;
    rdfs:range xsd:boolean .

:supportsIntersectionalAnalysis rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "supports intersectional analysis"@en ;
    rdfs:comment "True for metrics explicitly designed to assess fairness across intersectional or subgroup combinations of sensitive attributes."@en ;
    rdfs:domain :00023 ;
    rdfs:range xsd:boolean .

:systemURI rdf:type owl:DatatypeProperty ;
    rdfs:label "system URI"@en ;
    rdfs:domain :CodeSystem ;
    rdfs:range xsd:anyURI .

:uscdiDataElement rdf:type owl:DatatypeProperty ;
    rdfs:label "USCDI data element"@en ;
    rdfs:comment "The corresponding data element in the United States Core Data for Interoperability (USCDI), the version adopted by the ONC HTI-1 final rule."@en ;
    rdfs:domain :SensitiveAttribute ;
    rdfs:range xsd:string .

##############################################################################
#    Upper-level classes
##############################################################################

:00023 a owl:Class ;
    rdfs:label "fairness metric"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    skos:definition "A metric that quantifies the extent to which a model’s output does not discriminate (in the societal sense, based on a given notion of fairness) against individuals or groups defined by a sensitive attribute."@en ;
    owl:equivalentClass roadmap:01043 ;
    rdfs:comment "Asserted equivalent to ROADMAP fairness metric (roadmap:01043). The equivalence brings ROADMAP's existing fairness metrics (group fairness, individual fairness, equality of opportunity, demographic parity, equalized odds, counterfactual fairness) into the scope of this extension's property assertions."@en ;
    owl:disjointWith :00084 ;
    rdfs:subClassOf roadmap:01043 .

:StandardMetric a owl:Class ;
    rdfs:label "base metric"@en ;
    skos:altLabel "standard metric"@en ;
    skos:definition "A ROADMAP scalar performance metric that this extension characterises as a base metric: a standard measure of model performance from which one or more performance-dependent fairness metrics are computed. Membership is asserted, not intrinsic; a metric is a base metric relative to the fairness metrics derived from it."@en ;
    owl:disjointWith :00023 ;
    rdfs:subClassOf roadmap:03302 .

:00084 a owl:Class ;
    rdfs:label "metric property"@en ;
    skos:definition "An attribute used to characterise a metric in this ontology; the value partitions from which metric descriptions are drawn."@en .

:CodeSystem a owl:Class ;
    rdfs:label "code system"@en ;
    skos:definition "A controlled terminology or code system from which coded values are drawn."@en .

:MetricImplementation a owl:Class ;
    rdfs:label "metric implementation"@en ;
    skos:definition "A concrete implementation of a metric as a named function/method in a software toolkit."@en .

:SoftwareToolkit a owl:Class ;
    rdfs:label "software toolkit"@en ;
    skos:definition "A software library that implements fairness or performance metrics."@en .

##############################################################################
#    Value partitions
##############################################################################

###  Each partition is closed with owl:oneOf and its members declared pairwise distinct, so that a
###  reasoner can detect values outside the intended set and cannot conflate two members.

:00085 a owl:Class ;
    rdfs:label "performance-dependence"@en ;
    skos:definition "Whether fairness should be evaluated with respect to model performance or not."@en ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :00086 :00087 ) ] ;
    rdfs:subClassOf :00084 .

[ a owl:AllDifferent ; owl:distinctMembers ( :00086 :00087 ) ] .

:AggregationOperator a owl:Class ;
    rdfs:label "aggregation operator"@en ;
    dcterms:source <https://doi.org/10.17605/OSF.IO/Z83ND> ;
    skos:definition "The operator a fairness metric applies to a base quantity to summarise disparity across the groups defined by the sensitive attribute."@en ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :AggOp_AbsoluteDifference :AggOp_CoefficientOfVariation :AggOp_Correlation :AggOp_Difference :AggOp_GeneralisedEntropyIndex :AggOp_LogRatio :AggOp_Maximum :AggOp_Mean :AggOp_Minimum :AggOp_Ratio :AggOp_StandardDeviation :AggOp_Summation :AggOp_WassersteinDistance ) ] ;
    rdfs:subClassOf :00084 .

[ a owl:AllDifferent ; owl:distinctMembers ( :AggOp_AbsoluteDifference :AggOp_CoefficientOfVariation :AggOp_Correlation :AggOp_Difference :AggOp_GeneralisedEntropyIndex :AggOp_LogRatio :AggOp_Maximum :AggOp_Mean :AggOp_Minimum :AggOp_Ratio :AggOp_StandardDeviation :AggOp_Summation :AggOp_WassersteinDistance ) ] .

:BiasPreservationProperty a owl:Class ;
    rdfs:label "bias preservation property"@en ;
    dcterms:source <https://doi.org/10.2139/ssrn.3792772> ;
    skos:definition "Whether a fairness metric is bias-preserving (accepts the status quo / historical outcome labels as a valid reference) or bias-transforming (aims for substantive equality and challenges potentially biased historical labels)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :BiasPreservationProperty_Preserving :BiasPreservationProperty_Transforming ) ] ;
    rdfs:subClassOf :00084 .

[ a owl:AllDifferent ; owl:distinctMembers ( :BiasPreservationProperty_Preserving :BiasPreservationProperty_Transforming ) ] .

:EvaluationLevel a owl:Class ;
    rdfs:label "evaluation level"@en ;
    skos:definition "Whether fairness should be assessed at the level of estimated probability (P̂) or the predicted class (Ŷ)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :00088 :00089 ) ] ;
    rdfs:subClassOf :00084 .

[ a owl:AllDifferent ; owl:distinctMembers ( :00088 :00089 ) ] .

:FairnessDirection a owl:Class ;
    rdfs:label "fairness direction"@en ;
    dcterms:source <https://doi.org/10.17605/OSF.IO/Z83ND> ;
    skos:definition "The direction a metric's value moves as fairness improves toward its target value: lower, higher, or bidirectional."@en ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :FairnessDirection_Bidirectional :FairnessDirection_Higher :FairnessDirection_Lower ) ] ;
    rdfs:subClassOf :00084 .

[ a owl:AllDifferent ; owl:distinctMembers ( :FairnessDirection_Bidirectional :FairnessDirection_Higher :FairnessDirection_Lower ) ] .

:FairnessLevel a owl:Class ;
    rdfs:label "fairness level"@en ;
    skos:definition "The level at which a fairness metric compares outcomes: across groups defined by a sensitive attribute, or across similar individuals."@en ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :GroupFairness :IndividualFairness ) ] ;
    rdfs:subClassOf :00084 .

[ a owl:AllDifferent ; owl:distinctMembers ( :GroupFairness :IndividualFairness ) ] .

:GuidanceLevel a owl:Class ;
    rdfs:label "guidance level"@en ;
    skos:definition "The strength of recommendation attached to a fairness metric for use in clinical prediction modelling, as appraised by the cited source."@en ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :Inadvisable :Recommended :UseWithCaution ) ] ;
    rdfs:subClassOf :00084 .

[ a owl:AllDifferent ; owl:distinctMembers ( :Inadvisable :Recommended :UseWithCaution ) ] .

:MetricInput a owl:Class ;
    rdfs:label "metric input"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    skos:definition "A quantity or parameter that a metric requires as input in order to be computed, following the conditioning notation of the review's decision diagram, e.g. M(A, p-hat, tau, Y)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :Input_CensoringIndicator :Input_Covariates :Input_DecisionThreshold :Input_EstimatedProbability :Input_HistoricalOutcomeData :Input_LegitimateFeatures :Input_OutcomeLabel :Input_SensitiveAttribute :Input_TimeToEvent :Input_UtilityWeight ) ] ;
    rdfs:subClassOf :00084 .

[ a owl:AllDifferent ; owl:distinctMembers ( :Input_CensoringIndicator :Input_Covariates :Input_DecisionThreshold :Input_EstimatedProbability :Input_HistoricalOutcomeData :Input_LegitimateFeatures :Input_OutcomeLabel :Input_SensitiveAttribute :Input_TimeToEvent :Input_UtilityWeight ) ] .

:MetricSubtype a owl:Class ;
    rdfs:label "metric subtype"@en ;
    skos:definition "The aspect of model performance that a performance-dependent fairness metric compares across groups, such as discrimination, calibration, or clinical utility."@en ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :Calibration :ClinicalUtility :Discrimination :Overall :Partial :Summary ) ] ;
    rdfs:subClassOf :00084 .

[ a owl:AllDifferent ; owl:distinctMembers ( :Calibration :ClinicalUtility :Discrimination :Overall :Partial :Summary ) ] .

:ScoringPropriety a owl:Class ;
    rdfs:label "scoring propriety"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    skos:definition "Whether a performance metric is a proper, semi-proper, or improper scoring rule for probabilistic predictions (Van Calster et al. 2025)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :Propriety_Improper :Propriety_Proper :Propriety_SemiProper ) ] ;
    rdfs:subClassOf :00084 .

[ a owl:AllDifferent ; owl:distinctMembers ( :Propriety_Improper :Propriety_Proper :Propriety_SemiProper ) ] .

:SensitiveAttributeType a owl:Class ;
    rdfs:label "sensitive attribute type"@en ;
    dcterms:source <https://doi.org/10.17605/OSF.IO/Z83ND> ;
    skos:definition "The cardinality of sensitive (protected) attribute that a fairness metric supports as input: binary, multi-group (categorical with more than two groups), or continuous."@en ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :SensitiveAttributeType_Binary :SensitiveAttributeType_Continuous :SensitiveAttributeType_MultiGroup ) ] ;
    rdfs:subClassOf :00084 .

[ a owl:AllDifferent ; owl:distinctMembers ( :SensitiveAttributeType_Binary :SensitiveAttributeType_Continuous :SensitiveAttributeType_MultiGroup ) ] .

[ a owl:AllDisjointClasses ; owl:members ( :EvaluationLevel :FairnessLevel :GuidanceLevel :MetricSubtype :00085 :AggregationOperator :BiasPreservationProperty :FairnessDirection :MetricInput :ScoringPropriety :SensitiveAttributeType ) ] .

##############################################################################
#    Value-partition members
##############################################################################

:00086 a owl:NamedIndividual ,
         :00085 ;
    rdfs:label "performance-dependent"@en ;
    skos:altLabel "supervised fairness evaluation"@en ;
    skos:definition "A fairness metric that compares model performance across individuals or groups of individuals (eg, AUROC parity). See the definition of bias-preserving fairness metrics for implications."@en ;
    rdfs:comment "Bias-preserving fairness metrics:\nFairness metrics that aim to maintain the patterns observed in the data used for model development, such as specialist follow-up referral rates. These metrics assume that the distributions and outcomes present in the data reflect acceptable baselines. Consequently, the metrics prioritise consistency in model performance across groups rather than adjusting for underlying biases to effectively preserve the status quo in health-care delivery."@en .

:00087 a owl:NamedIndividual ,
         :00085 ;
    rdfs:label "performance-independent"@en ;
    skos:definition "A fairness metric that compares model behaviour (eg, by assessing parity in positivity rates) instead of comparing performance (eg, statistical parity) across individuals or groups of individuals. See bias-transforming fairness metrics entry for implications."@en ;
    rdfs:comment "Bias-transforming fairness metrics:\nFairness metrics that do not assume that clinical or societal biases (eg, disparities in disease prevalence, access to care, or historical disease patterns) should be preserved during model development. Although the performance of these metrics is typically independent of model performance, the metrics aim to ensure parity in predicted positivity rates. Their goal is to actively modify the influence of underlying data biases to promote greater fairness in outcomes."@en .

:AggOp_AbsoluteDifference a owl:NamedIndividual ,
                            :AggregationOperator ;
    rdfs:label "absolute difference"@en ;
    skos:definition "The absolute difference between two groups' values (ideal 0)."@en .

:AggOp_CoefficientOfVariation a owl:NamedIndividual ,
                                :AggregationOperator ;
    rdfs:label "coefficient of variation"@en ;
    skos:definition "The standard deviation of a base metric across groups divided by its mean."@en .

:AggOp_Correlation a owl:NamedIndividual ,
                     :AggregationOperator ;
    rdfs:label "correlation"@en ;
    skos:definition "A (rank) correlation between group performance and another per-group quantity."@en .

:AggOp_Difference a owl:NamedIndividual ,
                    :AggregationOperator ;
    rdfs:label "difference"@en ;
    skos:definition "The signed difference between two groups' values (ideal 0)."@en .

:AggOp_GeneralisedEntropyIndex a owl:NamedIndividual ,
                                 :AggregationOperator ;
    rdfs:label "generalised entropy index"@en ;
    skos:definition "An inequality index applied to per-group benefits."@en .

:AggOp_LogRatio a owl:NamedIndividual ,
                  :AggregationOperator ;
    rdfs:label "log ratio"@en ;
    skos:definition "The logarithm of the ratio of group values."@en .

:AggOp_Maximum a owl:NamedIndividual ,
                 :AggregationOperator ;
    rdfs:label "maximum"@en ;
    skos:definition "The maximum deviation across groups or group pairs (worst-case)."@en .

:AggOp_Mean a owl:NamedIndividual ,
              :AggregationOperator ;
    rdfs:label "mean"@en ;
    skos:definition "The mean of pairwise or per-group deviations."@en .

:AggOp_Minimum a owl:NamedIndividual ,
                 :AggregationOperator ;
    rdfs:label "minimum"@en ;
    skos:definition "The minimum of a base metric across groups (worst-group value)."@en .

:AggOp_Ratio a owl:NamedIndividual ,
               :AggregationOperator ;
    rdfs:label "ratio"@en ;
    skos:definition "The ratio of two groups' values (ideal 1)."@en .

:AggOp_StandardDeviation a owl:NamedIndividual ,
                           :AggregationOperator ;
    rdfs:label "standard deviation"@en ;
    skos:definition "The standard deviation of a base metric across groups."@en .

:AggOp_Summation a owl:NamedIndividual ,
                   :AggregationOperator ;
    rdfs:label "summation"@en ;
    skos:definition "A sum of per-group or pairwise deviations."@en .

:AggOp_WassersteinDistance a owl:NamedIndividual ,
                             :AggregationOperator ;
    rdfs:label "Wasserstein distance"@en ;
    skos:definition "The first Wasserstein (earth mover's) distance between per-group distributions."@en .

:BiasPreservationProperty_Preserving a owl:NamedIndividual ,
                                       :BiasPreservationProperty ;
    rdfs:label "bias-preserving"@en ;
    skos:definition "Maintains the patterns observed in the development data; performance is typically compared against existing outcome labels, preserving the status quo."@en .

:BiasPreservationProperty_Transforming a owl:NamedIndividual ,
                                         :BiasPreservationProperty ;
    rdfs:label "bias-transforming"@en ;
    skos:definition "Does not assume clinical or societal biases in the data should be preserved; aims for parity in predicted positivity rates to actively modify the influence of underlying data biases."@en .

:00088 a owl:NamedIndividual ,
         :EvaluationLevel ;
    rdfs:label "probability-based"@en ;
    skos:definition "A fairness metric in which estimated probabilities are used as input (eg, AUROC parity)."@en .

:00089 a owl:NamedIndividual ,
         :EvaluationLevel ;
    rdfs:label "threshold-dependent"@en ;
    skos:definition "Threshold-dependent metrics (eg, statistical parit) evaluate fairness at the predicted class level; the application of threshold-dependent metrics thus depends on applying a threshold to convert the estimated probability into class prediction."@en .

:FairnessDirection_Bidirectional a owl:NamedIndividual ,
                                   :FairnessDirection ;
    rdfs:label "bidirectional"@en ;
    skos:definition "Fairness improves as the metric value approaches the target from either side."@en .

:FairnessDirection_Higher a owl:NamedIndividual ,
                            :FairnessDirection ;
    rdfs:label "higher"@en ;
    skos:definition "Fairness improves as the metric value increases toward the target."@en .

:FairnessDirection_Lower a owl:NamedIndividual ,
                           :FairnessDirection ;
    rdfs:label "lower"@en ;
    skos:definition "Fairness improves as the metric value decreases toward the target."@en .

:GroupFairness a owl:NamedIndividual ,
                 :FairnessLevel ;
    rdfs:label "group fairness"@en ;
    skos:definition "Condition in which groups of individuals defined by sensitive attributes receive similar care."@en ;
    dcterms:source "Barocas, S ∙ Hardt, M ∙ Narayanan, A\nFairness and machine learning: limitations and opportunities\nMIT Press, 2023" .

:IndividualFairness a owl:NamedIndividual ,
                      :FairnessLevel ;
    rdfs:label "individual fairness"@en ;
    skos:definition "Condition in which similar individuals receive similar care. The concept of similarity is defined by a metric or distance that can be adjusted and agreed upon by relevant stakeholders (eg, patients, health-care professionals, and policy makers)."@en ;
    dcterms:source <https://doi.org/10.1145/2090236.2090255> .

:Inadvisable a owl:NamedIndividual ,
               :GuidanceLevel ;
    rdfs:label "inadvisable"@en .

:Recommended a owl:NamedIndividual ,
               :GuidanceLevel ;
    rdfs:label "recommended"@en .

:UseWithCaution a owl:NamedIndividual ,
                  :GuidanceLevel ;
    rdfs:label "use with caution"@en .

:Input_CensoringIndicator a owl:NamedIndividual ,
                            :MetricInput ;
    rdfs:label "censoring indicator"@en ;
    skos:definition "The censoring indicator distinguishing censored from uncensored observations."@en .

:Input_Covariates a owl:NamedIndividual ,
                    :MetricInput ;
    rdfs:label "covariates"@en ;
    skos:definition "The feature vector X (e.g. for computing individual similarity/distance or conditional strata)."@en .

:Input_DecisionThreshold a owl:NamedIndividual ,
                           :MetricInput ;
    rdfs:label "decision threshold"@en ;
    skos:definition "A decision threshold tau used to convert estimated probabilities into a predicted class."@en .

:Input_EstimatedProbability a owl:NamedIndividual ,
                              :MetricInput ;
    rdfs:label "estimated probability"@en ;
    skos:definition "The model's estimated probability (risk score) p-hat."@en .

:Input_HistoricalOutcomeData a owl:NamedIndividual ,
                               :MetricInput ;
    rdfs:label "historical outcome data"@en ;
    skos:definition "External measures of pre-existing health outcomes across subpopulations (e.g. required by reparative metrics such as HEAL)."@en .

:Input_LegitimateFeatures a owl:NamedIndividual ,
                            :MetricInput ;
    rdfs:label "legitimate features"@en ;
    skos:definition "The subset of features L deemed legitimate risk modifiers, used for conditioning."@en .

:Input_OutcomeLabel a owl:NamedIndividual ,
                      :MetricInput ;
    rdfs:label "outcome label"@en ;
    skos:definition "The ground-truth outcome label Y (required to assess performance)."@en .

:Input_SensitiveAttribute a owl:NamedIndividual ,
                            :MetricInput ;
    rdfs:label "sensitive attribute"@en ;
    skos:definition "The sensitive or protected attribute A along which fairness is evaluated."@en ;
    rdfs:seeAlso :SensitiveAttribute .

:Input_TimeToEvent a owl:NamedIndividual ,
                     :MetricInput ;
    rdfs:label "time to event"@en ;
    skos:definition "The observed time-to-event used in survival/time-to-event analyses."@en .

:Input_UtilityWeight a owl:NamedIndividual ,
                       :MetricInput ;
    rdfs:label "utility weight"@en ;
    skos:definition "A treatment utility / relative-weight parameter (e.g. lambda in net benefit)."@en .

:Calibration a owl:NamedIndividual ,
               :MetricSubtype ;
    rdfs:label "calibration"@en .

:ClinicalUtility a owl:NamedIndividual ,
                   :MetricSubtype ;
    rdfs:label "clinical utility"@en ;
    skos:definition "Metrics and plots that evaluate the potential benefit of model-guided decisions by assessing whether such decisions might result in better outcomes or fewer harms than those observed for the results from alternative strategies (eg, standard care, treat-all, treat-none, or another model)."@en .

:Discrimination a owl:NamedIndividual ,
                  :MetricSubtype ;
    rdfs:label "discrimination"@en .

:Overall a owl:NamedIndividual ,
           :MetricSubtype ;
    rdfs:label "overall"@en .

:Partial a owl:NamedIndividual ,
           :MetricSubtype ;
    rdfs:label "partial"@en .

:Summary a owl:NamedIndividual ,
           :MetricSubtype ;
    rdfs:label "summary"@en .

:Propriety_Improper a owl:NamedIndividual ,
                      :ScoringPropriety ;
    rdfs:label "improper"@en ;
    skos:definition "A metric that can be optimised by an incorrect model; not a proper scoring rule (e.g. threshold-dependent classification metrics considered alone)."@en .

:Propriety_Proper a owl:NamedIndividual ,
                    :ScoringPropriety ;
    rdfs:label "proper"@en ;
    skos:definition "A metric whose expected value is optimised only by the correct model."@en .

:Propriety_SemiProper a owl:NamedIndividual ,
                        :ScoringPropriety ;
    rdfs:label "semi-proper"@en ;
    skos:definition "A metric whose expected value is optimised by the correct model and by some incorrect models."@en .

:SensitiveAttributeType_Binary a owl:NamedIndividual ,
                                 :SensitiveAttributeType ;
    rdfs:label "binary"@en ;
    skos:definition "Supports a sensitive attribute with exactly two groups."@en .

:SensitiveAttributeType_Continuous a owl:NamedIndividual ,
                                     :SensitiveAttributeType ;
    rdfs:label "continuous"@en ;
    skos:definition "Supports a continuous sensitive attribute."@en .

:SensitiveAttributeType_MultiGroup a owl:NamedIndividual ,
                                     :SensitiveAttributeType ;
    rdfs:label "multi-group"@en ;
    skos:definition "Supports a categorical sensitive attribute with more than two groups."@en .

##############################################################################
#    Defined classes
##############################################################################

###  NOTE: in the previous release the three requiresInput-based classes below used
###  owl:someValuesFrom with a metric-input INDIVIDUAL in class position. That is punning, and
###  because nothing is ever typed as (say) :Input_OutcomeLabel, those three classes classified
###  nothing at all. They now use owl:hasValue, which is what was intended.

:group_fairness_metric a owl:Class ;
    rdfs:label "group fairness metric"@en ;
    skos:definition "Condition in which groups of individuals defined by sensitive attributes receive similar care."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :00023
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ) ] .

:individual_fairness_metric a owl:Class ;
    rdfs:label "individual fairness metric"@en ;
    skos:definition "Condition in which similar individuals receive similar care. The concept of similarity is defined by a metric or distance that can be adjusted and agreed upon by relevant stakeholders (eg, patients, health-care professionals, and policy makers)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :00023
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :IndividualFairness ] ) ] .

:performance-dependent_fairness_metric a owl:Class ;
    rdfs:label "performance-dependent fairness metric"@en ;
    skos:definition "A fairness metric that compares model performance across individuals or groups of individuals (eg, AUROC parity). See the definition of bias-preserving fairness metrics for implications."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :00023
        [ a owl:Restriction ; owl:onProperty :hasPerformanceDependence ; owl:hasValue :00086 ] ) ] .

:performance-independent_fairness_metric a owl:Class ;
    rdfs:label "performance-independent fairness metric"@en ;
    skos:definition "A fairness metric that compares model behaviour (eg, by assessing parity in positivity rates) instead of comparing performance (eg, statistical parity) across individuals or groups of individuals. See bias-transforming fairness metrics entry for implications."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :00023
        [ a owl:Restriction ; owl:onProperty :hasPerformanceDependence ; owl:hasValue :00087 ] ) ] .

:probability-based_fairness_metric a owl:Class ;
    rdfs:label "probability-based fairness metric"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2025.100916> ;
    skos:definition "A fairness metric in which estimated probabilities are used as input (eg, AUROC parity)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :00023
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00088 ] ) ] .

:threshold-dependent_fairness_metric a owl:Class ;
    rdfs:label "threshold-dependent fairness metric"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2025.100916> ;
    skos:definition "A fairness metric in which predicted classes (a result of converting estimated probabilities using a decision threshold) are used as inputs (eg, equality of opportunity difference)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :00023
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00089 ] ) ] .

:probability-based_base_metric a owl:Class ;
    rdfs:label "probability-based base metric"@en ;
    skos:definition "A base metric that takes estimated probabilities as input (e.g. AUROC, Brier score)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :StandardMetric
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00088 ] ) ] .

:threshold-dependent_base_metric a owl:Class ;
    rdfs:label "threshold-dependent base metric"@en ;
    skos:definition "A base metric that takes predicted classes as input, obtained by applying a decision threshold to estimated probabilities (e.g. true positive rate)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :StandardMetric
        [ a owl:Restriction ; owl:onProperty :hasEvaluationLevel ; owl:hasValue :00089 ] ) ] .

:conditioning_metric a owl:Class ;
    rdfs:label "conditioning metric"@en ;
    skos:definition "A metric that conditions on a set of legitimate features; derived from requiresInput value legitimate features."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        roadmap:03642
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_LegitimateFeatures ] ) ] .

:label_requiring_metric a owl:Class ;
    rdfs:label "label-requiring metric"@en ;
    skos:definition "A metric that cannot be computed without ground-truth outcome labels; derived from requiresInput value outcome label."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        roadmap:03642
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] ) ] .

:threshold_requiring_metric a owl:Class ;
    rdfs:label "threshold-requiring metric"@en ;
    skos:definition "A metric that cannot be computed without a chosen decision threshold; derived from requiresInput value decision threshold."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        roadmap:03642
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_DecisionThreshold ] ) ] .

##############################################################################
#    Code systems
##############################################################################

:codesystem_CDCREC a owl:NamedIndividual ,
                     :CodeSystem ;
    rdfs:label "CDC Race and Ethnicity Code Set (CDCREC)"@en ;
    rdfs:seeAlso <https://terminology.hl7.org/CodeSystem-CDCREC.html> ;
    :systemURI "urn:oid:2.16.840.1.113883.6.238"^^xsd:anyURI .

:codesystem_HL7AdministrativeGender a owl:NamedIndividual ,
                                      :CodeSystem ;
    rdfs:label "HL7 Administrative Gender"@en ;
    rdfs:seeAlso <https://hl7.org/fhir/valueset-administrative-gender.html> ;
    :systemURI "http://hl7.org/fhir/administrative-gender"^^xsd:anyURI .

:codesystem_LOINC a owl:NamedIndividual ,
                    :CodeSystem ;
    rdfs:label "LOINC"@en ;
    rdfs:seeAlso <https://loinc.org> ;
    :systemURI "http://loinc.org"^^xsd:anyURI .

:codesystem_SNOMEDCT a owl:NamedIndividual ,
                       :CodeSystem ;
    rdfs:label "SNOMED CT"@en ;
    rdfs:seeAlso <https://www.snomed.org> ;
    :systemURI "http://snomed.info/sct"^^xsd:anyURI .

##############################################################################
#    Sensitive attributes
#
#    A sensitive attribute is not a new kind of entity: it is a ROADMAP patient
#    descriptor (roadmap:03422) singled out as an axis along which model performance
#    is compared. This section therefore re-uses ROADMAP's descriptor hierarchy rather
#    than running a parallel one, and adds only what ROADMAP does not yet carry:
#    codes on the values, the two-question race/ethnicity format, gender identity
#    values, an intersex sex value, and the intersectional construct.
#
#    Convention (inherited from ROADMAP roadmap:03441): an attribute AXIS is a class;
#    a coded VALUE of that axis is an individual of it. ROADMAP is not internally
#    consistent about this - its sex values (roadmap:03428) and age groups
#    (roadmap:03449) are classes, not individuals - which is recorded as an open issue.
##############################################################################

:SensitiveAttribute a owl:Class ;
    rdfs:label "sensitive attribute"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    skos:definition "A ROADMAP patient descriptor used as an axis along which a model's performance or output is compared when evaluating fairness. Subclasses are specific axes (age, sex, gender identity, race and/or ethnicity, social determinants of health); individuals of those subclasses are coded values of the axis."@en ;
    rdfs:comment "Membership marks a descriptor as one that fairness evaluation may be stratified by. It is an assertion about use, not an intrinsic property of the descriptor: ROADMAP carries no marker of which descriptors are sensitive or legally protected, so this extension supplies one."@en ;
    rdfs:subClassOf roadmap:03422 .

###  ROADMAP descriptors asserted to be sensitive attributes.
###  These are additive axioms on classes owned by ROADMAP.

roadmap:03423 rdfs:subClassOf :SensitiveAttribute .   # age
roadmap:03424 rdfs:subClassOf :SensitiveAttribute .   # sex
roadmap:03432 rdfs:subClassOf :SensitiveAttribute .   # gender identity
roadmap:03441 rdfs:subClassOf :SensitiveAttribute .   # race / ethnicity
roadmap:03564 rdfs:subClassOf :SensitiveAttribute .   # social determinant of health
roadmap:03591 rdfs:subClassOf :SensitiveAttribute .   # geographic descriptor

###  Race and ethnicity.
###
###  ROADMAP roadmap:03441 carries the seven OMB 2024 (SPD-15 revision) categories, in which
###  race and ethnicity are collected as a single question. Most existing EHR data, and USCDI,
###  use the earlier OMB 1997 two-question format, which ROADMAP does not represent. The two
###  formats are NOT interchangeable, so the 1997 value sets are added here as separate axes
###  rather than being merged into roadmap:03441's individuals.

:Race a owl:Class ;
    rdfs:label "race (OMB 1997 two-question format)"@en ;
    dcterms:source <https://www.federalregister.gov/d/97-28653> ;
    skos:definition "Race of the individual as collected separately from ethnicity, per the 1997 OMB Statistical Policy Directive 15. Values are the five CDCREC race categories."@en ;
    rdfs:comment "Retained alongside roadmap:03441 because the two-question format remains in force in USCDI and in essentially all retrospective clinical data. Aggregating 1997 race and ethnicity into the 2024 combined categories is lossy and is not asserted here."@en ;
    :uscdiDataElement "Race" ;
    rdfs:subClassOf roadmap:03441 .

:Ethnicity a owl:Class ;
    rdfs:label "ethnicity (OMB 1997 two-question format)"@en ;
    dcterms:source <https://www.federalregister.gov/d/97-28653> ;
    skos:definition "Ethnicity of the individual as collected separately from race, per the 1997 OMB Statistical Policy Directive 15. Values are the two CDCREC ethnicity categories."@en ;
    :uscdiDataElement "Ethnicity" ;
    rdfs:subClassOf roadmap:03441 .

:Race_AmericanIndianOrAlaskaNative a owl:NamedIndividual ,
                                     :Race ;
    rdfs:label "American Indian or Alaska Native"@en ;
    :code "1002-5" ;
    :inCodeSystem :codesystem_CDCREC ;
    skos:closeMatch roadmap:03866 ;
    rdfs:comment "Close, not exact: American Indian or Alaska Native is collected by the OMB 2024 single-question format and this value by the 1997 two-question format, so the populations they select differ."@en .

:Race_Asian a owl:NamedIndividual ,
              :Race ;
    rdfs:label "Asian"@en ;
    :code "2028-9" ;
    :inCodeSystem :codesystem_CDCREC ;
    skos:closeMatch roadmap:03856 ;
    rdfs:comment "Close, not exact: Asian is collected by the OMB 2024 single-question format and this value by the 1997 two-question format, so the populations they select differ."@en .

:Race_BlackOrAfricanAmerican a owl:NamedIndividual ,
                               :Race ;
    rdfs:label "Black or African American"@en ;
    :code "2054-5" ;
    :inCodeSystem :codesystem_CDCREC ;
    skos:closeMatch roadmap:03857 ;
    rdfs:comment "Close, not exact: Black or African American is collected by the OMB 2024 single-question format and this value by the 1997 two-question format, so the populations they select differ."@en .

:Race_NativeHawaiianOrOtherPacificIslander a owl:NamedIndividual ,
                                             :Race ;
    rdfs:label "Native Hawaiian or Other Pacific Islander"@en ;
    :code "2076-8" ;
    :inCodeSystem :codesystem_CDCREC ;
    skos:closeMatch roadmap:03860 ;
    rdfs:comment "Close, not exact: Native Hawaiian or Pacific Islander is collected by the OMB 2024 single-question format and this value by the 1997 two-question format, so the populations they select differ."@en .

:Race_White a owl:NamedIndividual ,
              :Race ;
    rdfs:label "White"@en ;
    :code "2106-3" ;
    :inCodeSystem :codesystem_CDCREC ;
    skos:closeMatch roadmap:03861 ;
    rdfs:comment "Close, not exact: White is collected by the OMB 2024 single-question format and this value by the 1997 two-question format, so the populations they select differ."@en .

:Ethnicity_HispanicOrLatino a owl:NamedIndividual ,
                              :Ethnicity ;
    rdfs:label "Hispanic or Latino"@en ;
    :code "2135-2" ;
    :inCodeSystem :codesystem_CDCREC ;
    skos:closeMatch roadmap:03858 ;
    rdfs:comment "Close, not exact: Hispanic or Latino is collected by the OMB 2024 single-question format and this value by the 1997 two-question format, so the populations they select differ."@en .

:Ethnicity_NotHispanicOrLatino a owl:NamedIndividual ,
                                 :Ethnicity ;
    rdfs:label "Not Hispanic or Latino"@en ;
    :code "2186-5" ;
    :inCodeSystem :codesystem_CDCREC .

###  Codes for ROADMAP's OMB 2024 combined categories.
###  ROADMAP's seven roadmap:03441 individuals carry a label and nothing else. CDCREC codes for
###  the 2024 combined value set are not asserted here because the ones above belong to the 1997
###  value set and are not valid for the combined categories; "Middle Eastern or North African"
###  has no 1997 code at all. Supplying these requires a current CDCREC / SPD-15 release and is
###  listed as an open issue.

###  Sex.
###
###  ROADMAP represents sex values as CLASSES under roadmap:03428 (male sex, female sex,
###  unknown sex, sex not listed) and already carries SNOMED CT and LOINC mappings on the first
###  two. The previous release of this extension duplicated male and female as individuals with
###  the same SNOMED codes (248153007, 248152002); those duplicates are removed. Only intersex,
###  which ROADMAP lacks, is added.

:Sex_IntersexValue a owl:Class ;
    rdfs:label "intersex"@en ;
    skos:altLabel "disorder of sex development"@en ;
    skos:definition "A sex value for an individual born with physical or genetic characteristics that are not exclusively male or female."@en ;
    skos:exactMatch <http://purl.bioontology.org/ontology/SNOMEDCT/32570691000036108> ,
                    <http://snomed.info/id/32570691000036108> ;
    rdfs:comment "Proposed for addition to ROADMAP as a fourth sibling under sex value (roadmap:03428), which currently offers only male, female, unknown and not listed. Recording intersex as 'unknown' or 'not listed' conflates a sex value with missing data and makes the group unanalysable."@en ;
    rdfs:subClassOf roadmap:03428 .

:GenderIdentityValue a owl:Class ;
    rdfs:label "gender identity value"@en ;
    skos:definition "A coded value of gender identity."@en ;
    rdfs:comment """Proposed for addition to ROADMAP as a sibling of sex value (roadmap:03428). ROADMAP's gender identity class (roadmap:03432) states in a comment which values it should carry - male, female, nonbinary, exploring or questioning, another not listed, choose not to disclose, unknown - but defines none of them. Note that this is the USCDI value set, which differs from the SNOMED CT value set carried below: USCDI has 'exploring or questioning' and 'choose not to disclose' but no transgender or gender non-conforming values, while the SNOMED set has the reverse. Reconciling the two is an open issue; a fairness evaluation stratified by gender identity will give different subgroups depending on which is used."""@en ;
    rdfs:subClassOf roadmap:03422 .

roadmap:03432 rdfs:seeAlso :GenderIdentityValue .

:Gender_Female a owl:NamedIndividual ,
                 :GenderIdentityValue ;
    rdfs:label "identifies as female gender"@en ;
    :code "446141000124107" ;
    :inCodeSystem :codesystem_SNOMEDCT ;
    skos:exactMatch <http://purl.bioontology.org/ontology/SNOMEDCT/446141000124107> ,
                    <http://snomed.info/id/446141000124107> .

:Gender_Male a owl:NamedIndividual ,
               :GenderIdentityValue ;
    rdfs:label "identifies as male gender"@en ;
    :code "446151000124109" ;
    :inCodeSystem :codesystem_SNOMEDCT ;
    skos:exactMatch <http://purl.bioontology.org/ontology/SNOMEDCT/446151000124109> ,
                    <http://snomed.info/id/446151000124109> .

:Gender_NonBinary a owl:NamedIndividual ,
                    :GenderIdentityValue ;
    rdfs:label "identifies as non-binary gender"@en ;
    :code "33791000087105" ;
    :inCodeSystem :codesystem_SNOMEDCT ;
    skos:exactMatch <http://purl.bioontology.org/ontology/SNOMEDCT/33791000087105> ,
                    <http://snomed.info/id/33791000087105> .

:Gender_NonConforming a owl:NamedIndividual ,
                        :GenderIdentityValue ;
    rdfs:label "identifies as gender non-conforming (genderqueer)"@en ;
    :code "446131000124102" ;
    :inCodeSystem :codesystem_SNOMEDCT ;
    skos:exactMatch <http://purl.bioontology.org/ontology/SNOMEDCT/446131000124102> ,
                    <http://snomed.info/id/446131000124102> .

:Gender_TransgenderFemale a owl:NamedIndividual ,
                            :GenderIdentityValue ;
    rdfs:label "transgender female (male-to-female)"@en ;
    :code "407376001" ;
    :inCodeSystem :codesystem_SNOMEDCT ;
    skos:exactMatch <http://purl.bioontology.org/ontology/SNOMEDCT/407376001> ,
                    <http://snomed.info/id/407376001> .

:Gender_TransgenderMale a owl:NamedIndividual ,
                          :GenderIdentityValue ;
    rdfs:label "transgender male (female-to-male)"@en ;
    :code "407377005" ;
    :inCodeSystem :codesystem_SNOMEDCT ;
    skos:exactMatch <http://purl.bioontology.org/ontology/SNOMEDCT/407377005> ,
                    <http://snomed.info/id/407377005> .

:SocioeconomicStatus a owl:Class ;
    rdfs:label "socioeconomic status"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    skos:definition "Socioeconomic status of the individual: a multidimensional construct spanning education, income, employment and housing, typically operationalised through a proxy such as an area deprivation index or insurance status."@en ;
    skos:closeMatch roadmap:03588 ;
    rdfs:comment "Close, not exact, to ROADMAP economic stability (roadmap:03588): socioeconomic status as used in the fairness literature also spans education access and quality (roadmap:03584) and neighborhood and built environment (roadmap:03585). No value set is defined here or in ROADMAP; in practice studies use an index (e.g. an area deprivation index) rather than an enumerated value set, so this axis needs a quantitative rather than categorical representation."@en ;
    rdfs:subClassOf roadmap:03564 .

:IntersectionalSensitiveAttribute a owl:Class ;
    rdfs:label "intersectional sensitive attribute"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    skos:definition "A sensitive attribute formed by the intersection of two or more base sensitive attribute values (e.g. age x race x sex), capturing overlapping disadvantage that is invisible when each axis is examined separately."@en ;
    rdfs:comment "ROADMAP has no construct for combining patient descriptors, so this is supplied here and proposed for upstreaming. Only 3 of the 60 fairness metrics in this extension support intersectional analysis."@en ;
    rdfs:subClassOf roadmap:03422 .

:IntersectionalExample_ElderlyBlackWoman a owl:NamedIndividual ,
                                           :IntersectionalSensitiveAttribute ;
    rdfs:label "elderly Black woman (illustrative)"@en ;
    skos:definition "An illustrative intersectional subgroup combining an age band, a race value and a gender identity value."@en ;
    :combinesAttribute :Gender_Female ,
                       :Race_BlackOrAfricanAmerican ;
    rdfs:comment "The age component of this example cannot be asserted. ROADMAP represents age bands as CLASSES under age group (roadmap:03449), so 'adult 65 years and over' (roadmap:03458) cannot be the object of :combinesAttribute, whose range is a value individual. This is the clearest consequence of ROADMAP's inconsistent treatment of values and is recorded as an open issue."@en .


