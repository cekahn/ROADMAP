### :00049  error distribution disparity index
:00049 a owl:Class ;
    rdfs:label "error distribution disparity index"@en ;
    skos:definition "Measures the deviation of subgroup error rates relative to the overall error rate, designed for settings with substantial data variability and diverse subgroup sizes."@en ;
    dcterms:source <https://proceedings.mlr.press/v252/wang24a.html> ;
    :hasTargetValue "0" ;
    :hasGuidanceRationale "Flawed models can yield higher values than robust ones; treats all errors alike; limited to one decision threshold."@en ;
    # class error
    :hasRelatedMetric roadmap:03330 ;
    rdfs:subClassOf :00023 ,
        roadmap:03302 ,
        [ a owl:Restriction ; owl:onProperty :hasFairnessLevel ; owl:hasValue :GroupFairness ] ,
