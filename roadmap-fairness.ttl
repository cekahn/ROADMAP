        [ a owl:Restriction ; owl:onProperty :proposedForHealthcare ; owl:hasValue "false"^^xsd:boolean ] ,
        [ a owl:Restriction ; owl:onProperty roadmap:optimum ; owl:hasValue "0"^^xsd:integer ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_DecisionThreshold ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_EstimatedProbability ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] ,
        [ a owl:Restriction ; owl:onProperty :hasImplementation ; owl:hasValue :impl_AIF360_statistical_parity_difference ] ,
        [ a owl:Restriction ; owl:onProperty :hasImplementation ; owl:hasValue :impl_Fairlearn_demographic_parity_difference ] .

### :00074  subgroup net benefit
:00074 a owl:Class ;
    rdfs:label "subgroup net benefit"@en ;
    skos:definition "Evaluates the expected clinical benefit of applying a model to a subgroup, incorporating outcome prevalence, the proportions of true and false positives at a decision threshold, and a weighting factor reflecting treatment effectiveness."@en ;
    dcterms:source <https://doi.org/10.1097/EDE.0000000000001949> ;
    :hasTargetValue "1 - prevalence" ;
    :hasGuidanceRationale "Combines discrimination and calibration; only clinical-utility metric identified; assumes different prevalence per subgroup."@en ;
