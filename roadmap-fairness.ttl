        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_OutcomeLabel ] ,
        [ a owl:Restriction ; owl:onProperty :requiresInput ; owl:hasValue :Input_SensitiveAttribute ] .

### :00050  error rate ratio
:00050 a owl:Class ;
    rdfs:label "error rate ratio"@en ;
    skos:altLabel "accuracy ratio"@en ;
    skos:altLabel "zero-one loss ratio"@en ;
    skos:definition "The ratio of error rates between the unprivileged and privileged groups; equivalent to the overall accuracy ratio."@en ;
    dcterms:source <https://doi.org/10.1001/amajethics.2019.167> ;
    :hasTargetValue "1" ;
    :hasGuidanceRationale "Flawed models can yield higher values than robust ones; treats all errors alike; limited to one decision threshold."@en ;
    # class error
    :hasRelatedMetric roadmap:03330 ;
