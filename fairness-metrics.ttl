        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00039 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "conditional statistical parity"@en ;
    dcterms:source <https://jmlr.org/papers/v24/22-1511.html> ;
    skos:definition "An extension of statistical parity that controls for a limited set of legitimate features (independent of the protected attribute), requiring an equal proportion of individuals to be selected from each group within strata defined by those features."@en ;
    :dependsOnPrevalence true ;
    :hasAggregationOperator :AggOp_AbsoluteDifference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Transforming ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Recommended ;
    :hasGuidanceRationale "Relevant when legitimate factors (e.g., comorbidities) justify group-specific risk estimates; aligns with EU non-discrimination law."@en ;
    :hasPerformanceDependence :00087 ;
    :hasRelatedMetric roadmap:03228 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_LegitimateFeatures,
        :Input_SensitiveAttribute .

:00040 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "conditional use accuracy equality"@en ;
    dcterms:source <https://doi.org/10.1145/3306618.3314278> ;
    skos:altLabel "positive and negative predictive parity"@en ;
    skos:definition "Similar to equalised odds but for predictive values; requires equal positive and negative predictive values across groups."@en ;
