:AggOp_Correlation a owl:NamedIndividual,
        :AggregationOperator ;
    rdfs:label "correlation"@en ;
    skos:definition "A (rank) correlation between group performance and another per-group quantity."@en .

:AggOp_GeneralisedEntropyIndex a owl:NamedIndividual,
        :AggregationOperator ;
