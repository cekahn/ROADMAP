:00035 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "censoring-based individual fairness"@en ;
    dcterms:source <https://doi.org/10.1145/3534678.3539259> ;
    skos:definition "Builds on survival individual fairness by incorporating censoring, aiming for patients with similar features and outcomes to receive similar predictions even when some are censored."@en ;
    :dependsOnPrevalence true ;
    :hasAggregationOperator :AggOp_Mean ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Transforming ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :IndividualFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "One of only 2 individual-fairness metrics identified in the review; insufficient empirical evaluation."@en ;
    :hasPerformanceDependence :00087 ;
    :hasRelatedMetric roadmap:03226 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_MultiGroup ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_CensoringIndicator,
        :Input_Covariates,
        :Input_EstimatedProbability,
        :Input_SensitiveAttribute,
        :Input_TimeToEvent .

:00036 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "children metrics"@en ;
    dcterms:source <https://doi.org/10.1109/ICDE48307.2020.00203>,
        <https://openreview.net/forum?id=YigKlMJwjye> ;
    skos:definition "A family of metrics extending statistical/demographic parity beyond the binary case: multi-group demographic parity generalises it to categorical sensitive attributes, generalised demographic parity (GDP) extends it to continuous sensitive attributes, and statistical parity subgroup fairness weights the positive-prediction-rate disparity by subgroup representation."@en ;
    :dependsOnPrevalence true ;
    :hasAggregationOperator :AggOp_Summation ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Transforming ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Family of statistical-parity-derived metrics (intersectional/generalised demographic parity variants)."@en ;
    :hasImplementation :impl_AIF360_statistical_parity_difference,
        :impl_Fairlearn_demographic_parity_difference ;
    :hasParentMetric :00073 ;
    :hasPerformanceDependence :00087 ;
    :hasRelatedMetric roadmap:03228 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Continuous ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_SensitiveAttribute ;
    :supportsIntersectionalAnalysis true .

:00037 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "concordance imparity"@en ;
    dcterms:source <https://doi.org/10.1609/aaai.v36i11.21484> ;
    skos:definition "Quantifies disparities in a model's discriminative ability across groups in the presence of censoring, as the maximum deviation between weighted subgroup concordance fractions."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_Maximum ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
