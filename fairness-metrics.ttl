        :Input_EstimatedProbability,
        :Input_SensitiveAttribute ;
    :supportsIntersectionalAnalysis true .

:00042 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "disparate impact"@en ;
    dcterms:source <https://doi.org/10.1145/2783258.2783311> ;
    skos:definition "Quantifies the legal concept of disparate impact as the ratio of positive-prediction rates across groups, associated with the 80% (four-fifths) rule; considers only prediction-rate similarity and not the ground truth."@en ;
    :dependsOnPrevalence true ;
    :hasAggregationOperator :AggOp_Ratio ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Transforming ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Connected to US disparate impact law; the associated four-fifths rule is neither necessary nor sufficient for the legal standard."@en ;
