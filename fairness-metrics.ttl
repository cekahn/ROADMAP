    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Can quickly summarise how a model behaves when comparing subgroups; restricted as only a mean value is reported."@en ;
    :hasPerformanceDependence :00087 ;
    :hasRelatedMetric roadmap:03228 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_EstimatedProbability,
        :Input_SensitiveAttribute .

:00058 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "mean-performance-scaled disparity AUROC"@en ;
    dcterms:source <https://doi.org/10.48550/arXiv.2310.02492> ;
    skos:definition "Quantifies the disparity in AUROC across subgroups as the standard deviation of subgroup AUROCs normalised by the overall AUROC."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_StandardDeviation ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Reported in a preprint; insufficient validation."@en ;
    :hasMetricSubtype :Discrimination ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :AUROC ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_MultiGroup ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00060 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "overall accuracy gap"@en ;
    dcterms:source <https://doi.org/10.1177/0049124118782533> ;
    skos:altLabel "error disparity"@en ;
    skos:definition "Requires that overall accuracy is similar across groups; mathematically equivalent to an error (zero-one loss) disparity."@en ;
    :dependsOnPrevalence true ;
    :hasAggregationOperator :AggOp_AbsoluteDifference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Flawed models can yield higher values than robust ones; treats all errors alike; limited to one decision threshold."@en ;
    :hasImplementation :impl_AIF360_error_rate_difference ;
    :hasMetricSubtype :Summary ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :Accuracy ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00061 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "pairwise ranking fairness"@en ;
    dcterms:source <https://doi.org/10.1109/TPAMI.2023.3290949> ;
    skos:definition "Quantifies the probability that a randomly selected positive instance from a group is ranked higher than a randomly selected negative instance from any group."@en ;
    :dependsOnPrevalence false ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Higher ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Insufficient knowledge/support; seldom used in healthcare."@en ;
    :hasMetricSubtype :Discrimination ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :AUROC ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "1" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00062 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "pairwise ranking fairness disparity"@en ;
    dcterms:source <https://doi.org/10.1109/TPAMI.2023.3290949> ;
    skos:definition "Measures the absolute difference in pairwise ranking fairness between two groups, capturing disparities in ranking probabilities."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_AbsoluteDifference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Insufficient knowledge/support; seldom used in healthcare."@en ;
    :hasMetricSubtype :Discrimination ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :AUROC ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00065 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "recall between-group generalised entropy index"@en ;
    dcterms:source <https://doi.org/10.1145/3219819.3220046> ;
    skos:definition "Applies the generalised entropy index (an inequality measure) to subgroup-average benefits to quantify between-group inequality, using a benefit function that encodes equal opportunity in the recall case."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_GeneralisedEntropyIndex ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Scenarios for justified use are unclear; hard to interpret."@en ;
    :hasImplementation :impl_AIF360_between_group_generalized_entropy_index ;
    :hasMetricSubtype :Partial ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :TPR ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_MultiGroup ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00066 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "recall coefficient of variation"@en ;
    dcterms:source <https://doi.org/10.1145/3306618.3314278> ;
    skos:definition "Measures the relative variability of recall across groups as the ratio of its standard deviation to its mean, giving a scale-independent measure of disparity."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_CoefficientOfVariation ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Scenarios for justified use are unclear; hard to interpret."@en ;
    :hasImplementation :impl_AIF360_between_group_coefficient_of_variation ;
    :hasMetricSubtype :Partial ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :TPR,
        roadmap:03580 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_MultiGroup ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00067 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "recall disparity ratio"@en ;
    dcterms:source <https://doi.org/10.2196/58572> ;
    skos:definition "Measures the ratio of recall between the lowest-recall and highest-recall groups, quantifying the relative performance gap between best- and worst-performing groups."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_Ratio ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Higher ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Scenarios for justified use are unclear; hard to interpret."@en ;
    :hasMetricSubtype :Partial ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :TPR ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_MultiGroup ;
    :hasTargetValue "1" ;
    :proposedForHealthcare true ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00069 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "recall intergroup standard deviation"@en ;
    dcterms:source <https://doi.org/10.1145/3593013.3594102> ;
    skos:definition "Measures the variability (standard deviation) of recall across groups; part of the intergroup-standard-deviation family applicable to any performance metric."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_StandardDeviation ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Scenarios for justified use are unclear; hard to interpret."@en ;
    :hasMetricSubtype :Partial ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :TPR ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_MultiGroup ;
    :hasTargetValue "0" ;
    :proposedForHealthcare true ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00070 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "recall-HEAL"@en ;
    dcterms:source <https://doi.org/10.1016/j.eclinm.2024.102479> ;
    skos:definition "The Health Equity Assessment of machine Learning performance (HEAL) metric evaluates the anticorrelation between pre-existing health outcomes and AI performance across subpopulations, rewarding higher performance for historically disadvantaged groups (reparative fairness)."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_Correlation ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Transforming ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Higher ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Introduces reparative fairness via anticorrelation with historical disease burden; complex tradeoffs and ethical debates; use of external data can be arbitrary."@en ;
    :hasMetricSubtype :Partial ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :TPR ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_MultiGroup ;
    :hasTargetValue "1" ;
    :proposedForHealthcare true ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_HistoricalOutcomeData,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00071 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "regression demographic parity"@en ;
    dcterms:source <https://doi.org/10.48550/arXiv.2310.03146> ;
    skos:definition "An extension of average (mean) score parity to sensitive attributes with more than two categories, evaluating whether average predicted outcomes differ across subpopulations."@en ;
    :dependsOnPrevalence true ;
    :hasAggregationOperator :AggOp_Mean ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Transforming ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Reported in a preprint; same limitations as mean score parity."@en ;
    :hasPerformanceDependence :00087 ;
    :hasRelatedMetric roadmap:03228 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_MultiGroup ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_EstimatedProbability,
        :Input_SensitiveAttribute .

:00072 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "sAUROC"@en ;
    dcterms:source <https://doi.org/10.1016/j.ebiom.2024.105002> ;
    skos:definition "Evaluates subgroup-specific false positive rates while computing the true positive rate over the whole population, capturing performance differences between subgroups."@en ;
    :dependsOnPrevalence false ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Bidirectional ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Insufficient knowledge/support; seldom used in healthcare."@en ;
    :hasMetricSubtype :Discrimination ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :AUROC ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0.5" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00074 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "subgroup net benefit"@en ;
    dcterms:source <https://doi.org/10.1097/EDE.0000000000001949> ;
    skos:definition "Evaluates the expected clinical benefit of applying a model to a subgroup, incorporating outcome prevalence, the proportions of true and false positives at a decision threshold, and a weighting factor reflecting treatment effectiveness."@en ;
    :dependsOnPrevalence false ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Higher ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Recommended ;
    :hasGuidanceRationale "Combines discrimination and calibration; only clinical-utility metric identified; assumes different prevalence per subgroup."@en ;
    :hasMetricSubtype :ClinicalUtility ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric roadmap:03662 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_MultiGroup ;
    :hasTargetValue "1 - prevalence" ;
    :proposedForHealthcare true ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute,
        :Input_UtilityWeight .

:00075 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "survival group fairness"@en ;
    dcterms:source <https://doi.org/10.48550/arXiv.2010.06820> ;
    skos:definition "Measures the worst-case deviation of the per-group expected hazard function from the population-average hazard across protected groups, in survival analysis."@en ;
    :dependsOnPrevalence true ;
    :hasAggregationOperator :AggOp_Maximum ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Transforming ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Extends fairness to survival/time-to-event settings; insufficient empirical evaluation."@en ;
    :hasPerformanceDependence :00087 ;
    :hasRelatedMetric roadmap:03225 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_MultiGroup ;
    :hasTargetValue "0" ;
    :proposedForHealthcare true ;
    :requiresInput :Input_Covariates,
        :Input_EstimatedProbability,
        :Input_SensitiveAttribute,
        :Input_TimeToEvent .

:00076 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "survival individual fairness"@en ;
    dcterms:source <https://doi.org/10.48550/arXiv.2010.06820> ;
    skos:definition "Measures whether a survival model produces similar estimated hazard scores for individuals deemed similar under a predefined distance metric, penalising differences that exceed the feature-space distance."@en ;
    :dependsOnPrevalence true ;
    :hasAggregationOperator :AggOp_Summation ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Transforming ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :IndividualFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "One of only 2 individual-fairness metrics identified in the review."@en ;
    :hasPerformanceDependence :00087 ;
    :hasRelatedMetric roadmap:03226 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_MultiGroup ;
    :hasTargetValue "0" ;
    :proposedForHealthcare true ;
    :requiresInput :Input_Covariates,
        :Input_EstimatedProbability,
        :Input_SensitiveAttribute,
        :Input_TimeToEvent .

:00077 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "survival intersectional fairness"@en ;
    dcterms:source <https://doi.org/10.48550/arXiv.2010.06820> ;
    skos:definition "Evaluates disparities in the log-ratios of per-group hazard functions between intersectional subgroups, addressing vulnerabilities that arise at these intersections."@en ;
    :dependsOnPrevalence true ;
    :hasAggregationOperator :AggOp_Maximum ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Insufficient empirical evaluation."@en ;
    :hasPerformanceDependence :00087 ;
    :hasRelatedMetric roadmap:03225 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_MultiGroup ;
    :hasTargetValue "0" ;
    :proposedForHealthcare true ;
    :requiresInput :Input_Covariates,
        :Input_EstimatedProbability,
        :Input_SensitiveAttribute,
        :Input_TimeToEvent ;
    :supportsIntersectionalAnalysis true .

:00078 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "treatment equality"@en ;
    dcterms:source <https://doi.org/10.1177/0049124118782533> ;
    skos:altLabel "error rate balance"@en ;
    skos:definition "Also known as error-rate balance; focuses on the ratio of false positives to false negatives across groups, requiring an equal proportion of error types."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_Difference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Appears utility-inspired but not explicitly defined as such; rationale and implications unclear."@en ;
    :hasMetricSubtype :Summary ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :FNR,
        :FPR ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00079 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "unsupervised ranking fairness"@en ;
    dcterms:source <https://doi.org/10.1109/TPAMI.2023.3290949> ;
    skos:definition "Measures the disparity in ranking probabilities between two protected groups, acting as a concordance statistic for whether each group is equally likely to rank higher than the other, independent of performance."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_AbsoluteDifference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Transforming ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "May be of value if unsupervised discrimination analysis is deemed necessary; not sufficiently validated in healthcare."@en ;
    :hasPerformanceDependence :00087 ;
    :hasRelatedMetric roadmap:03572 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_EstimatedProbability,
        :Input_SensitiveAttribute .

:00081 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "worst-group recall"@en ;
    dcterms:source <https://doi.org/10.1145/3461702.3462523> ;
    skos:altLabel "worst-group outcome"@en ;
    skos:definition "Focuses on the minimum recall across all groups, prioritising improvement for the most disadvantaged group in line with minimax (Rawlsian) fairness."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_Minimum ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Higher ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Linked to Rawls' Theory of Justice (maximise minimum benefit); sensitive to outlier subgroups."@en ;
    :hasMetricSubtype :Partial ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :TPR ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_MultiGroup ;
    :hasTargetValue "Max Recall" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00082 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "xAUROC"@en ;
    dcterms:source <https://papers.nips.cc/paper_files/paper/2019/hash/73e0f7487b8e5297182c5a711d20bf26-Abstract.html> ;
    skos:altLabel "cross-AUC"@en ;
    skos:definition "The cross-area under the ROC curve captures group-level misranking disparities, measuring the probability that a randomly chosen positive instance from one group is ranked higher than a randomly chosen negative instance from another group."@en ;
    :dependsOnPrevalence false ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Bidirectional ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Insufficient knowledge/support; seldom used in healthcare."@en ;
    :hasMetricSubtype :Discrimination ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :AUROC ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0.5" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00083 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "xAUROC disparity"@en ;
    dcterms:source <https://papers.nips.cc/paper_files/paper/2019/hash/73e0f7487b8e5297182c5a711d20bf26-Abstract.html> ;
    skos:definition "Measures the difference in xAUROC values between two sensitive groups; antisymmetric, capturing the magnitude and direction of cross-group ranking disparities."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_AbsoluteDifference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Insufficient knowledge/support; seldom used in healthcare."@en ;
    :hasMetricSubtype :Discrimination ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :AUROC ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:Aequitas a owl:NamedIndividual,
        :SoftwareToolkit ;
    rdfs:label "Aequitas"@en ;
    rdfs:seeAlso <http://aequitas.dssg.io> .

:Combined_AmericanIndianOrAlaskaNative a owl:NamedIndividual,
        :CombinedRaceEthnicity ;
    rdfs:label "American Indian or Alaska Native"@en ;
    skos:exactMatch :Race_AmericanIndianOrAlaskaNative .

:Combined_Asian a owl:NamedIndividual,
        :CombinedRaceEthnicity ;
    rdfs:label "Asian"@en ;
    skos:exactMatch :Race_Asian .

:Combined_BlackOrAfricanAmerican a owl:NamedIndividual,
        :CombinedRaceEthnicity ;
    rdfs:label "Black or African American"@en ;
    skos:exactMatch :Race_BlackOrAfricanAmerican .

:Combined_HispanicOrLatino a owl:NamedIndividual,
        :CombinedRaceEthnicity ;
    rdfs:label "Hispanic or Latino"@en ;
    rdfs:comment "Crosswalk to OMB 1997 'Hispanic or Latino' is approximate: in 1997 this was an ethnicity captured in a separate question; in 2024 it is a co-equal category in the single combined question."@en ;
    skos:closeMatch <http://snomed.info/id/414408004>,
        :Ethnicity_HispanicOrLatino .

:Combined_MiddleEasternOrNorthAfrican a owl:NamedIndividual,
        :CombinedRaceEthnicity ;
    rdfs:label "Middle Eastern or North African"@en ;
    rdfs:comment "No established OMB-minimum-category interoperability code as of this modelling (CDCREC/US Core have not yet added a 2024 MENA category code)."@en ;
    skos:definition "New OMB 2024 minimum category, separate and distinct from White; individuals in this group were previously classified as White under the 1997 standard."@en ;
    skos:relatedMatch :Race_White .

:Combined_NativeHawaiianOrPacificIslander a owl:NamedIndividual,
        :CombinedRaceEthnicity ;
    rdfs:label "Native Hawaiian or Pacific Islander"@en ;
    skos:closeMatch :Race_NativeHawaiianOrOtherPacificIslander .

:Combined_White a owl:NamedIndividual,
        :CombinedRaceEthnicity ;
    rdfs:label "White"@en ;
    rdfs:comment "Crosswalk to OMB 1997 White is approximate: the 1997 White category included Middle Eastern or North African, which the 2024 standard separates out."@en ;
    skos:closeMatch <http://snomed.info/id/413773004>,
        :Race_White ;
    skos:definition "Under the OMB 2024 standard, White excludes Middle Eastern or North African, which is now its own category."@en .

:Ethnicity_NotHispanicOrLatino a owl:NamedIndividual,
        :Ethnicity ;
    rdfs:label "Not Hispanic or Latino"@en ;
    rdfs:comment "Has no counterpart among the OMB 2024 combined minimum categories, which record Hispanic or Latino as a co-equal category and treat its absence as 'not Hispanic or Latino' rather than as a distinct category."@en ;
