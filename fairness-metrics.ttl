    :hasRelatedMetric roadmap:04033 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_MultiGroup ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00045 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "equal opportunity difference"@en ;
    dcterms:source <https://proceedings.neurips.cc/paper/2016/hash/9d2682367c3935defcb1f9e247a97c0d-Abstract.html> ;
    skos:altLabel "false negative error rate balance"@en,
        "recall parity"@en ;
    skos:definition "Also known as recall parity or false-negative-error-rate balance; requires that true positive rates are similar across groups, so individuals with a positive outcome are equally likely to receive a positive prediction."@en ;
    :dependsOnPrevalence false ;
