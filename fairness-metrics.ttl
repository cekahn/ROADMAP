    rdfs:label "overall"@en .

roadmap:03228 a owl:NamedIndividual .

:CombinedRaceEthnicity a owl:Class ;
    rdfs:label "race and ethnicity (OMB 2024 combined)"@en ;
    dcterms:source <https://www.federalregister.gov/documents/2024/03/29/2024-06469/revisions-to-ombs-statistical-policy-directive-no-15-standards-for-maintaining-collecting-and> ;
    rdfs:comment "As of this modelling no standard interoperability code system (CDCREC, SNOMED US edition, USCDI) yet encodes these seven categories as OMB minimum categories; values are therefore crosswalked to the coded OMB 1997 values rather than carrying their own codes."@en ;
    rdfs:seeAlso <https://loinc.org/46463-6> ;
    rdfs:subClassOf :SensitiveAttribute ;
    skos:definition "Race and ethnicity as a single combined attribute per the OMB 2024 revision of Statistical Policy Directive 15, which collects race and ethnicity in one question with seven co-equal minimum categories and adds 'Middle Eastern or North African' as a new category."@en ;
    :loincQuestionCode "46463-6"^^xsd:string ;
    :uscdiDataElement "Not yet in USCDI: USCDI (through current versions) and FHIR US Core still reference OMB 1997; alignment with the 2024 standard is recommended but pending (federal compliance deadline 28 March 2029)."^^xsd:string .

:Input_Covariates a owl:NamedIndividual,
        :MetricInput ;
    rdfs:label "covariates"@en ;
