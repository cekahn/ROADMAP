@prefix : <https://gamuts.net/fairness-metrics/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix roadmap: <https://rsna.org/roadmap/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:source a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

: a owl:Ontology .

:Age a owl:Class ;
    rdfs:label "age"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    rdfs:comment "No enumerated value set: age is continuous and may be discretised into bands for subgroup analysis."@en ;
    rdfs:subClassOf :SensitiveAttribute ;
    skos:definition "Age of the individual; typically continuous and often analysed in bands."@en ;
    skos:exactMatch <http://snomed.info/id/397669002> ;
    :uscdiDataElement "Date of Birth (USCDI Patient Demographics)"^^xsd:string .

:IntersectionalExample_ElderlyBlackWoman a owl:NamedIndividual,
        :IntersectionalSensitiveAttribute ;
    rdfs:label "elderly Black woman (illustrative)"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    rdfs:comment "Also characterised by advanced age (~80 years); age is continuous and has no enumerated value to reference."@en ;
    skos:definition "Illustrative intersectional subgroup used in the review (an 80-year-old Black woman) to show disadvantage not captured by separate age, race, or gender assessments."@en ;
    :combinesAttribute :Gender_Female,
        :Race_BlackOrAfricanAmerican .

:SocioeconomicStatus a owl:Class ;
    rdfs:label "socioeconomic status"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    rdfs:comment "No single standard value set: represent via the relevant SDOH data elements (e.g. educational attainment, employment status, income, housing status), which may be coded in SNOMED CT or LOINC."@en ;
    rdfs:seeAlso <https://www.healthit.gov/isp/uscdi> ;
    rdfs:subClassOf :SensitiveAttribute ;
    skos:definition "Socioeconomic status of the individual: a multidimensional construct spanning education, income, employment, and housing, typically captured through social-determinants-of-health (SDOH) data rather than a single coded value set."@en ;
    :uscdiDataElement "Social Determinants of Health (USCDI v3 SDOH data class)"^^xsd:string .

:code a owl:DatatypeProperty ;
    rdfs:label "code"@en ;
    rdfs:comment "The code for a value within its code system (see inCodeSystem)."@en ;
    rdfs:range xsd:string .

:codesystem_HL7AdministrativeGender a owl:NamedIndividual,
        :CodeSystem ;
    rdfs:label "HL7 Administrative Gender"@en ;
    rdfs:seeAlso <https://hl7.org/fhir/valueset-administrative-gender.html> ;
    :systemURI "http://hl7.org/fhir/administrative-gender"^^xsd:anyURI .

:codesystem_LOINC a owl:NamedIndividual,
        :CodeSystem ;
    rdfs:label "LOINC"@en ;
    rdfs:seeAlso <https://loinc.org> ;
    :systemURI "http://loinc.org"^^xsd:anyURI .

:combinesAttribute a owl:ObjectProperty ;
    rdfs:label "combines attribute"@en ;
    rdfs:comment "Links an intersectional sensitive attribute to each base sensitive-attribute value it combines (e.g. a 'Black women' subgroup combines the race value 'Black or African American' and the gender value 'identifies as female gender'). Values are individuals of the axis subclasses and hence of SensitiveAttribute."@en ;
    rdfs:domain :IntersectionalSensitiveAttribute ;
    rdfs:range :SensitiveAttribute .

:conditioning_metric a owl:Class ;
    rdfs:label "conditioning metric"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Metric [ a owl:Restriction ;
                        owl:onProperty :requiresInput ;
                        owl:someValuesFrom :Input_LegitimateFeatures ] ) ] ;
    skos:definition "A metric that conditions on a set of legitimate features; derived from requiresInput some legitimate features."@en .

:dependsOnPrevalence a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "depends on prevalence"@en ;
    rdfs:comment "Whether the metric's value depends on the base outcome prevalence within each sensitive-attribute group."@en ;
    rdfs:domain :00023 ;
    rdfs:range xsd:boolean .

:functionName a owl:DatatypeProperty ;
    rdfs:label "function name"@en ;
    rdfs:domain :MetricImplementation ;
    rdfs:range xsd:string .

:group_fairness_metric a owl:Class ;
    rdfs:label "group fairness metric"@en ;
    rdfs:subClassOf :00023 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :00023 [ a owl:Restriction ;
                        owl:hasValue :GroupFairness ;
                        owl:onProperty :hasFairnessLevel ] ) ] ;
    skos:definition "Condition in which groups of individuals defined by sensitive attributes receive similar care."@en .

:hasAggregationOperator a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has aggregation operator"@en ;
    dcterms:source <https://doi.org/10.17605/OSF.IO/Z83ND> ;
    rdfs:comment "The primary operator the fairness metric applies to its base metric across groups. Left unset for metrics that are novel cross-group constructions (e.g. xAUROC, sAUROC, pairwise ranking fairness, equity-scaled metrics) or that combine two sub-metrics via a reported design choice of max/mean (e.g. equalised odds, conditional use accuracy equality), and for subgroup net benefit, which is reported per subgroup rather than reduced by a fixed operator."@en ;
    rdfs:domain :00023 ;
    rdfs:range :AggregationOperator .

:hasBiasPreservationProperty a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has bias preservation property"@en ;
    dcterms:source <https://doi.org/10.2139/ssrn.3792772> ;
    rdfs:comment "Whether the metric is bias-preserving or bias-transforming, per Wachter, Mittelstadt & Russell (2021) as applied in the source catalogue."@en ;
    rdfs:domain :00023 ;
    rdfs:range :BiasPreservationProperty .

:hasFairnessDirection a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has fairness direction"@en ;
    dcterms:source <https://doi.org/10.17605/OSF.IO/Z83ND> ;
    rdfs:comment "The direction the metric value takes as fairness improves toward its target."@en ;
    rdfs:domain :00023 ;
    rdfs:range :FairnessDirection .

:hasGuidanceLevel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has guidance level"@en ;
    rdfs:domain :00023 ;
    rdfs:range :GuidanceLevel .

:hasGuidanceRationale a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has guidance rationale"@en ;
    rdfs:domain :00023 ;
    rdfs:range rdf:langString .

:hasImplementation a owl:ObjectProperty ;
    rdfs:label "has implementation"@en ;
    rdfs:comment "Links a metric to a concrete function/method in a fairness toolkit. Function names for AIF360 (ClassificationMetric) and Fairlearn (fairlearn.metrics) were verified against current documentation; note that a toolkit function may compute the complement of the named metric (e.g. false-omission-rate difference for NPV difference, since NPV = 1 - FOR). This layer is a starting scaffold and should be pinned to specific toolkit versions and extended (e.g. Aequitas, fairmodels) as needed."@en ;
    rdfs:domain :Metric ;
    rdfs:range :MetricImplementation .

:hasMatchingMetric a owl:ObjectProperty ;
    rdfs:label "has matching metric"@en ;
    rdfs:comment "Links a fairness metric to a ROADMAP (https://rsna.org/roadmap/) scalar metric it is identical to (e.g., 'statistical parity' hasMatchingMetric roadmap:demographic parity). Used in place of skos:exactMatch to avoid an individual-to-class mapping, since fairness metrics in this ontology are individuals while their ROADMAP counterparts are classes. For fairness-aware adaptations of a base performance metric rather than an identical concept, :hasRelatedMetric is used instead."@en ;
    rdfs:domain :Metric .

:hasMetricSubtype a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has metric subtype"@en ;
    rdfs:comment "Only applicable to metrics for which hasPerformanceDependence = performance-dependent (00086); performance-independent metrics do not have a metric subtype in this taxonomy."@en ;
    rdfs:domain :Metric ;
    rdfs:range :MetricSubtype .

:hasParentMetric a owl:ObjectProperty ;
    rdfs:label "has parent metric"@en ;
    rdfs:domain :00023 ;
    rdfs:range :00023 .

:hasRelatedMetric a owl:ObjectProperty ;
    rdfs:label "has related metric"@en ;
    rdfs:comment "Links a fairness metric to the base metric it operationalises, extends, or is computed from. Points to an internal :StandardMetric individual where one exists (which in turn carries a :hasMatchingMetric link to ROADMAP); otherwise points directly to the corresponding ROADMAP (https://rsna.org/roadmap/) concept when no internal standard metric is defined. For a fairness metric identical to a ROADMAP concept, :hasMatchingMetric is used instead."@en ;
    rdfs:domain :Metric .

:hasScoringPropriety a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has scoring propriety"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    rdfs:comment "The scoring-rule propriety of a (base) performance metric. Asserted on the standard metrics; fairness metrics inherit it via hasRelatedMetric. Proper and semi-proper are stated explicitly in the review for Brier score, expected calibration error, AUROC, and AUPRC; the threshold-dependent classification metrics are improper as scoring rules per the cited guidance (Van Calster et al. 2025)."@en ;
    rdfs:domain :Metric ;
    rdfs:range :ScoringPropriety .

:hasSupportedSensitiveAttributeType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has supported sensitive attribute type"@en ;
    dcterms:source <https://doi.org/10.17605/OSF.IO/Z83ND> ;
    rdfs:comment "The cardinality of sensitive attribute the metric supports, as reported in the source catalogue. Values are broadly nested (continuous > multi-group > binary), but only the level stated in the catalogue is asserted here."@en ;
    rdfs:domain :00023 ;
    rdfs:range :SensitiveAttributeType .

:hasTargetValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has target value"@en ;
    rdfs:comment "The value representing perfect fairness for the metric, as reported in the source catalogue. Recorded as a string because targets are heterogeneous (e.g. 0, 1, 0.5, a range, or a reference to another quantity such as the overall AUROC or (1 - prevalence))."@en ;
    rdfs:domain :00023 ;
    rdfs:range xsd:string .

:inCodeSystem a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "in code system"@en ;
    rdfs:range :CodeSystem .

:incompatibleWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "incompatible with"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    rdfs:comment "Indicates that the two fairness metrics cannot in general be satisfied simultaneously (mutual-satisfiability / impossibility results). These incompatibilities are typically CONDITIONAL: they hold when outcome prevalence (base rate) differs across the groups defined by the sensitive attribute and the model is not perfectly accurate. Symmetric. Sources: Kleinberg et al. 2016; Chouldechova 2017, as cited in the review."@en ;
    rdfs:domain :00023 ;
    rdfs:range :00023 .

:individual_fairness_metric a owl:Class ;
    rdfs:label "individual fairness metric"@en ;
    rdfs:subClassOf :00023 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :00023 [ a owl:Restriction ;
                        owl:hasValue :IndividualFairness ;
                        owl:onProperty :hasFairnessLevel ] ) ] ;
    skos:definition "Condition in which similar individuals receive similar care. The concept of similarity is defined by a metric or distance that can be adjusted and agreed upon by relevant stakeholders (eg, patients, health-care professionals, and policy makers)."@en .

:label_requiring_metric a owl:Class ;
    rdfs:label "label-requiring metric"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Metric [ a owl:Restriction ;
                        owl:onProperty :requiresInput ;
                        owl:someValuesFrom :Input_OutcomeLabel ] ) ] ;
    skos:definition "A metric that cannot be computed without ground-truth outcome labels; derived from requiresInput some outcome label."@en .

:loincQuestionCode a owl:DatatypeProperty ;
    rdfs:label "LOINC question code"@en ;
    rdfs:comment "The LOINC code for the observation/question that captures this attribute (the coded answer values come from CDCREC/SNOMED, not LOINC)."@en ;
    rdfs:domain :SensitiveAttribute ;
    rdfs:range xsd:string .

:performance-dependent_fairness_metric a owl:Class ;
    rdfs:label "performance-dependent fairness metric"@en ;
    rdfs:subClassOf :00023 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :00023 [ a owl:Restriction ;
                        owl:hasValue :00086 ;
                        owl:onProperty :hasPerformanceDependence ] ) ] ;
    skos:definition "A fairness metric that compares model performance across individuals or groups of individuals (eg, AUROC parity). See the definition of bias-preserving fairness metrics for implications."@en .

:performance-independent_fairness_metric a owl:Class ;
    rdfs:label "performance-independent fairness metric"@en ;
    rdfs:subClassOf :00023 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :00023 [ a owl:Restriction ;
                        owl:hasValue :00087 ;
                        owl:onProperty :hasPerformanceDependence ] ) ] ;
    skos:definition "A fairness metric that compares model behaviour (eg, by assessing parity in positivity rates) instead of comparing performance (eg, statistical parity) across individuals or groups of individuals. See bias-transforming fairness metrics entry for implications."@en .

:probability-based_base_metric a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :StandardMetric [ a owl:Restriction ;
                        owl:hasValue :00088 ;
                        owl:onProperty :hasEvaluationLevel ] ) ] ;
    skos:definition "A fairness metric in which estimated probabilities are used as input (eg, AUROC parity)."@en .

:probability-based_fairness_metric a owl:Class ;
    rdfs:label "probability-based fairness metric"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2025.100916> ;
    rdfs:subClassOf :00023 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :00023 [ a owl:Restriction ;
                        owl:hasValue :00088 ;
                        owl:onProperty :hasEvaluationLevel ] ) ] ;
    skos:definition "A fairness metric in which estimated probabilities are used as input (eg, AUROC parity)."@en .

:proposedForHealthcare a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "proposed for healthcare"@en ;
    rdfs:domain :00023 ;
    rdfs:range xsd:boolean .

:providedByToolkit a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "provided by toolkit"@en ;
    rdfs:domain :MetricImplementation ;
    rdfs:range :SoftwareToolkit .

:shouldBePairedWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "should be paired with"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    rdfs:comment "Indicates that the two fairness metrics should be reported together to be interpretable, per the review's critical appraisal (e.g. a discrimination metric paired with a calibration metric; true-positive-rate and false-positive-rate parity reported together). Symmetric."@en ;
    rdfs:domain :00023 ;
    rdfs:range :00023 .

:supportsIntersectionalAnalysis a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "supports intersectional analysis"@en ;
    rdfs:comment "True for metrics explicitly designed to assess fairness across intersectional or subgroup combinations of sensitive attributes."@en ;
    rdfs:domain :00023 ;
    rdfs:range xsd:boolean .

:systemURI a owl:DatatypeProperty ;
    rdfs:label "system URI"@en ;
    rdfs:domain :CodeSystem ;
    rdfs:range xsd:anyURI .

:threshold-dependent_base_metric a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :StandardMetric [ a owl:Restriction ;
                        owl:hasValue :00089 ;
                        owl:onProperty :hasEvaluationLevel ] ) ] ;
    skos:definition "A fairness metric in which predicted classes (a result of converting estimated probabilities using a decision threshold) are used as inputs (eg, equality of opportunity difference)."@en .

:threshold-dependent_fairness_metric a owl:Class ;
    rdfs:label "threshold-dependent fairness metric"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2025.100916> ;
    rdfs:subClassOf :00023 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :00023 [ a owl:Restriction ;
                        owl:hasValue :00089 ;
                        owl:onProperty :hasEvaluationLevel ] ) ] ;
    skos:definition "A fairness metric in which predicted classes (a result of converting estimated probabilities using a decision threshold) are used as inputs (eg, equality of opportunity difference)."@en .

:threshold_requiring_metric a owl:Class ;
    rdfs:label "threshold-requiring metric"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Metric [ a owl:Restriction ;
                        owl:onProperty :requiresInput ;
                        owl:someValuesFrom :Input_DecisionThreshold ] ) ] ;
    skos:definition "A metric that cannot be computed without a chosen decision threshold; derived from requiresInput some decision threshold."@en .

:uscdiDataElement a owl:DatatypeProperty ;
    rdfs:label "USCDI data element"@en ;
    rdfs:comment "The corresponding data element in the United States Core Data for Interoperability (USCDI), the version adopted by the ONC HTI-1 final rule."@en ;
    rdfs:domain :SensitiveAttribute ;
    rdfs:range xsd:string .

:00025 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "AUPRC parity"@en ;
    dcterms:source <https://doi.org/10.1145/3306618.3314278> ;
    skos:definition "Measures the difference in area under the precision-recall curve (AUPRC) between subgroups defined by the sensitive attribute."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_AbsoluteDifference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "AUPRC is semi-proper and can be an explicitly discriminatory metric favouring higher-prevalence subgroups."@en ;
    :hasMetricSubtype :Discrimination ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :AUPRC ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00026 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "AUROC parity"@en ;
    dcterms:source <https://doi.org/10.1145/3442188.3445879> ;
    skos:definition "Measures the difference in AUROC (discrimination) between subgroups defined by the sensitive attribute; a value of 0 indicates no difference in discrimination across groups."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_AbsoluteDifference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Recommended ;
    :hasGuidanceRationale "Recommended if paired with a calibration-related parity metric; AUROC alone only reflects discrimination."@en ;
    :hasMetricSubtype :Discrimination ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :AUROC ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare true ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute ;
    :shouldBePairedWith :00024,
        :00033,
        :00044,
        :00051,
        :00080 .

:00027 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "average disparity in equalised odds"@en ;
    dcterms:source <https://proceedings.mlr.press/v252/wang24a.html> ;
    skos:definition "Measures the average deviation from equalised odds by aggregating pairwise true-positive-rate and false-positive-rate differences across all subgroups defined by the sensitive attribute."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_Mean ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Unclear how quantities should be combined; incompatible with other metrics under differing prevalence."@en ;
    :hasMetricSubtype :Partial ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric roadmap:03229 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_MultiGroup ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00028 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "average odds difference"@en ;
    dcterms:source <https://doi.org/10.1145/3448891.3448943> ;
    skos:definition "Computes the average of the false-positive-rate and true-positive-rate differences across protected groups, combining the equalised-odds components into a single measure."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_Mean ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Unclear aggregation; naming (\"odds\") can be misleading."@en ;
    :hasImplementation :impl_AIF360_average_odds_difference ;
    :hasMetricSubtype :Partial ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric roadmap:03229 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00029 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "balance for negative class"@en ;
    dcterms:source <https://doi.org/10.48550/arXiv.1609.05807> ;
    skos:definition "Requires that subjects in the negative class from both groups receive equal average estimated probabilities."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_Difference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Not studied for use in clinical prediction models."@en ;
    :hasMetricSubtype :Overall ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric roadmap:03762 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00030 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "balance for positive class"@en ;
    dcterms:source <https://doi.org/10.48550/arXiv.1609.05807> ;
    skos:definition "Requires that subjects in the positive class from both groups receive equal average estimated probabilities."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_Difference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Not studied for use in clinical prediction models."@en ;
    :hasMetricSubtype :Overall ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric roadmap:03762 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00031 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "balanced accuracy difference"@en ;
    dcterms:source <https://doi.org/10.1145/3630106.3658902> ;
    skos:definition "Evaluates the disparity in balanced accuracy between a protected and an unprotected group."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_Difference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :Inadvisable ;
    :hasGuidanceRationale "Flawed models can yield higher values than robust ones; treats all errors alike; limited to one decision threshold."@en ;
    :hasMetricSubtype :Summary ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :BalancedAccuracy ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00032 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "Brier score parity"@en ;
    dcterms:source <https://doi.org/10.1145/3306618.3314278> ;
    skos:definition "Measures the difference in Brier score between subgroups, reflecting the consistency of combined calibration and accuracy of probabilistic predictions across groups."@en ;
    :dependsOnPrevalence true ;
    :hasAggregationOperator :AggOp_AbsoluteDifference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Proper metric but hard to interpret; mixes discrimination and calibration."@en ;
    :hasMetricSubtype :Overall ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :BrierScore ;
