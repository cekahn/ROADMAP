:requiresInput a owl:ObjectProperty ;
    rdfs:label "requires input"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    rdfs:comment "The quantities/parameters a metric needs to be computed. Non-functional: most metrics require several inputs. Base inputs follow from the metric's performance-dependence and evaluation level (per the review's decision diagram); additional inputs (legitimate features, time-to-event, censoring, utility weight, historical outcome data) are asserted per metric."@en ;
    rdfs:domain :Metric ;
    rdfs:range :MetricInput .

