    skos:definition "The ratio of two groups' values (ideal 1)."@en .

:AggOp_Summation a owl:NamedIndividual,
        :AggregationOperator ;
    rdfs:label "summation"@en ;
    skos:definition "A sum of per-group or pairwise deviations."@en .

:EvaluationLevel a owl:Class ;
