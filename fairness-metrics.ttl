    :systemURI "http://snomed.info/sct"^^xsd:anyURI .

:AUROC a owl:NamedIndividual,
        :StandardMetric ;
    rdfs:label "area under the receiver operating characteristic curve"@en ;
    dcterms:source <https://doi.org/10.17605/OSF.IO/Z83ND> ;
    skos:altLabel "AUC"@en,
        "AUC-ROC"@en,
        "AUROC"@en ;
    skos:definition "The area under the curve plotting the true positive rate against the false positive rate across decision thresholds; equivalently, the probability that a randomly chosen positive instance is ranked higher than a randomly chosen negative instance. A threshold-independent measure of discrimination."@en ;
    :hasEvaluationLevel :00088 ;
    :hasMatchingMetric roadmap:03314 ;
    :hasScoringPropriety :Propriety_SemiProper ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel .

:AggOp_Difference a owl:NamedIndividual,
        :AggregationOperator ;
    rdfs:label "difference"@en ;
    skos:definition "The signed difference between two groups' values (ideal 0)."@en .

:MetricInput a owl:Class ;
    rdfs:label "metric input"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    rdfs:subClassOf :00084 ;
    skos:definition "A quantity or parameter that a metric requires as input in order to be computed, following the conditioning notation of the review's decision diagram, e.g. M(A, p-hat, tau, Y)."@en .

:00084 a owl:Class ;
    rdfs:label "metric property"@en .

:Discrimination a owl:NamedIndividual,
        :MetricSubtype ;
    rdfs:label "discrimination"@en .

:Metric a owl:Class ;
    rdfs:label "metric"@en ;
    skos:definition "Any quantitative measure of model behaviour or fairness. Superclass of fairness metrics and standard (base) performance metrics."@en .

:SensitiveAttribute a owl:Class ;
    rdfs:label "sensitive attribute"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    skos:definition "A characteristic or axis along which fairness can be evaluated. Its subclasses are specific sensitive attributes (age, sex, gender, race, ethnicity, socioeconomic status); their individuals are the coded categories/values of each attribute. Distinct from sensitive-attribute type, which is the cardinality (binary/multi-group/continuous) a metric supports."@en .

:Propriety_Improper a owl:NamedIndividual,
        :ScoringPropriety ;
    rdfs:label "improper"@en ;
    skos:definition "A metric that can be optimised by an incorrect model; not a proper scoring rule (e.g. threshold-dependent classification metrics considered alone)."@en .

:AIF360 a owl:NamedIndividual,
        :SoftwareToolkit ;
    rdfs:label "AI Fairness 360 (AIF360)"@en ;
    rdfs:seeAlso <https://aif360.res.ibm.com> .

:AggregationOperator a owl:Class ;
    rdfs:label "aggregation operator"@en ;
    dcterms:source <https://doi.org/10.17605/OSF.IO/Z83ND> ;
    rdfs:subClassOf :00084 ;
    skos:definition "The operator a fairness metric applies to a base quantity to summarise disparity across the groups defined by the sensitive attribute."@en .

:BiasPreservationProperty_Transforming a owl:NamedIndividual,
        :BiasPreservationProperty ;
    rdfs:label "bias-transforming"@en ;
    skos:definition "Does not assume clinical or societal biases in the data should be preserved; aims for parity in predicted positivity rates to actively modify the influence of underlying data biases."@en .

:00087 a owl:NamedIndividual,
        :00085 ;
    rdfs:label "performance-independent"@en ;
    rdfs:comment """Bias-transforming fairness metrics:
Fairness metrics that do not assume that clinical or societal biases (eg, disparities in disease prevalence, access to care, or historical disease patterns) should be preserved during model development. Although the performance of these metrics is typically independent of model performance, the metrics aim to ensure parity in predicted positivity rates. Their goal is to actively modify the influence of underlying data biases to promote greater fairness in outcomes."""@en ;
    skos:definition "A fairness metric that compares model behaviour (eg, by assessing parity in positivity rates) instead of comparing performance (eg, statistical parity) across individuals or groups of individuals. See bias-transforming fairness metrics entry for implications."@en .

:StandardMetric a owl:Class ;
    rdfs:label "base metric"@en ;
    rdfs:subClassOf :Metric ;
    owl:disjointWith :00023 ;
    skos:altLabel "standard metric"@en ;
    skos:definition "A standard model performance evaluation metric (for example, one derived from the confusion matrix) that assesses a model's output against a ground-truth label and can serve as a base metric from which performance-dependent fairness metrics are computed."@en .

:AggOp_AbsoluteDifference a owl:NamedIndividual,
        :AggregationOperator ;
    rdfs:label "absolute difference"@en ;
    skos:definition "The absolute difference between two groups' values (ideal 0)."@en .

:Partial a owl:NamedIndividual,
        :MetricSubtype ;
    rdfs:label "partial"@en .

:MetricImplementation a owl:Class ;
    rdfs:label "metric implementation"@en ;
    skos:definition "A concrete implementation of a metric as a named function/method in a software toolkit."@en .

:SensitiveAttributeType_MultiGroup a owl:NamedIndividual,
        :SensitiveAttributeType ;
    rdfs:label "multi-group"@en ;
    skos:definition "Supports a categorical sensitive attribute with more than two groups."@en .

:UseWithCaution a owl:NamedIndividual,
        :GuidanceLevel ;
    rdfs:label "use with caution"@en .

:00088 a owl:NamedIndividual,
        :EvaluationLevel ;
    rdfs:label "probability-based"@en ;
    owl:differentFrom :00089 ;
    skos:definition "A fairness metric in which estimated probabilities are used as input (eg, AUROC parity)."@en .

:Inadvisable a owl:NamedIndividual,
        :GuidanceLevel ;
    rdfs:label "inadvisable"@en .

:SensitiveAttributeType_Binary a owl:NamedIndividual,
        :SensitiveAttributeType ;
    rdfs:label "binary"@en ;
    skos:definition "Supports a sensitive attribute with exactly two groups."@en .

:Input_DecisionThreshold a owl:NamedIndividual,
        :MetricInput ;
    rdfs:label "decision threshold"@en ;
    skos:definition "A decision threshold tau used to convert estimated probabilities into a predicted class."@en .

:00089 a owl:NamedIndividual,
        :EvaluationLevel ;
    rdfs:label "threshold-dependent"@en ;
    skos:definition "Threshold-dependent metrics (eg, statistical parit) evaluate fairness at the predicted class level; the application of threshold-dependent metrics thus depends on applying a threshold to convert the estimated probability into class prediction."@en .

:BiasPreservationProperty_Preserving a owl:NamedIndividual,
        :BiasPreservationProperty ;
    rdfs:label "bias-preserving"@en ;
    owl:differentFrom :BiasPreservationProperty_Transforming ;
    skos:definition "Maintains the patterns observed in the development data; performance is typically compared against existing outcome labels, preserving the status quo."@en .

:00086 a owl:NamedIndividual,
        :00085 ;
    rdfs:label "performance-dependent"@en ;
    rdfs:comment """Bias-preserving fairness metrics:
Fairness metrics that aim to maintain the patterns observed in the data used for model development, such as specialist follow-up referral rates. These metrics assume that the distributions and outcomes present in the data reflect acceptable baselines. Consequently, the metrics prioritise consistency in model performance across groups rather than adjusting for underlying biases to effectively preserve the status quo in health-care delivery."""@en ;
    owl:differentFrom :00087 ;
    skos:altLabel "supervised fairness evaluation"@en ;
    skos:definition "A fairness metric that compares model performance across individuals or groups of individuals (eg, AUROC parity). See the definition of bias-preserving fairness metrics for implications."@en .

:FairnessDirection_Lower a owl:NamedIndividual,
        :FairnessDirection ;
    rdfs:label "lower"@en ;
    skos:definition "Fairness improves as the metric value decreases toward the target."@en .

:GroupFairness a owl:NamedIndividual,
        :FairnessLevel ;
    rdfs:label "group fairness"@en ;
    dcterms:source """Barocas, S ∙ Hardt, M ∙ Narayanan, A
Fairness and machine learning: limitations and opportunities
MIT Press, 2023""" ;
    owl:differentFrom :IndividualFairness ;
    skos:definition "Condition in which groups of individuals defined by sensitive attributes receive similar care."@en .

:Input_SensitiveAttribute a owl:NamedIndividual,
        :MetricInput ;
    rdfs:label "sensitive attribute"@en ;
    rdfs:seeAlso :SensitiveAttribute ;
    skos:definition "The sensitive or protected attribute A along which fairness is evaluated."@en .

:Input_OutcomeLabel a owl:NamedIndividual,
        :MetricInput ;
    rdfs:label "outcome label"@en ;
    skos:definition "The ground-truth outcome label Y (required to assess performance)."@en .

:Input_EstimatedProbability a owl:NamedIndividual,
        :MetricInput ;
    rdfs:label "estimated probability"@en ;
    skos:definition "The model's estimated probability (risk score) p-hat."@en .

:00023 a owl:Class ;
    rdfs:label "fairness metric"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    rdfs:subClassOf :Metric ;
    owl:disjointWith :00084 ;
    skos:definition "A metric that quantifies the extent to which a model’s output does not discriminate (in the societal sense, based on a given notion of fairness) against individuals or groups defined by a sensitive attribute."@en .

