:00024 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "absolute calibration error parity"@en ;
    dcterms:source <https://doi.org/10.1145/3531146.3533166> ;
    skos:definition "Measures the difference in absolute calibration error between subgroups, quantifying disparities in overall calibration by assessing deviations from perfect calibration."@en ;
    :dependsOnPrevalence true ;
    :hasAggregationOperator :AggOp_AbsoluteDifference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Should be paired with a per-group calibration plot and a discrimination metric; criticised for sensitivity to calibration binning and for treating over-/under-estimation equally."@en ;
    :hasMetricSubtype :Calibration ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :ECE ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare true ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00033 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "calibration-in-the-large parity"@en ;
    dcterms:source <https://doi.org/10.1038/s41597-021-01110-7> ;
    skos:definition "Measures the difference in calibration-in-the-large between subgroups, quantifying whether systematic overestimation or underestimation of risk varies across groups."@en ;
    :dependsOnPrevalence true ;
    :hasAggregationOperator :AggOp_AbsoluteDifference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Can be informative but should always accompany a calibration plot and discrimination metric."@en ;
    :hasMetricSubtype :Calibration ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric roadmap:03655 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare true ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00051 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "expected calibration error parity"@en ;
    dcterms:source <https://doi.org/10.1101/2023.09.18.23295660> ;
    skos:definition "Quantifies the difference in expected calibration error between groups defined by the sensitive attribute; 0 when the model is equally calibrated across groups."@en ;
    :dependsOnPrevalence true ;
    :hasAggregationOperator :AggOp_AbsoluteDifference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Proper metric, but criticised for sensitivity to calibration binning and for treating over-/under-estimation equally."@en ;
    :hasMetricSubtype :Calibration ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :ECE ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare true ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00059 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "negative predictive value difference"@en ;
    dcterms:source <https://doi.org/10.1145/3630106.3658902> ;
    skos:definition "Computes the difference in negative predictive value across protected groups, measuring disparities in the accuracy of negative predictions."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_AbsoluteDifference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Same considerations as predictive parity."@en ;
    :hasImplementation :impl_AIF360_false_omission_rate_difference ;
    :hasMetricSubtype :Partial ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :NPV ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00063 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "predictive equality"@en ;
    dcterms:source <https://doi.org/10.1145/3097983.3098095> ;
    skos:altLabel "false positive error rate balance"@en,
        "specificity parity"@en ;
    skos:definition "Also known as false-positive-error-rate balance or specificity parity; requires that false positive rates are similar across groups."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_AbsoluteDifference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Same considerations as equal opportunity difference."@en ;
    :hasImplementation :impl_AIF360_false_positive_rate_difference ;
    :hasMetricSubtype :Partial ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :FPR ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute ;
    :shouldBePairedWith :00068 .

:00064 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "predictive parity"@en ;
    dcterms:source <https://doi.org/10.1145/3593013.3594117> ;
    skos:altLabel "outcome test"@en ;
    skos:definition "Also known as the outcome test; requires that positive predictive values (precision) are similar across groups."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_AbsoluteDifference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Easily interpreted; base metric improper alone."@en ;
    :hasImplementation :impl_AIF360_false_discovery_rate_difference ;
    :hasMetricSubtype :Partial ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric :PPV ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute ;
    :shouldBePairedWith :00059 .

:00073 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "statistical parity"@en ;
    dcterms:source <https://proceedings.mlr.press/v28/zemel13.html> ;
    skos:altLabel "demographic parity"@en,
        "statistical parity difference"@en,
        "thresholded score parity"@en ;
    skos:definition "Also known as demographic parity; the threshold-dependent counterpart of mean score parity, assessing the extent to which the rate of positive predictions differs between groups. Does not use the ground-truth outcome."@en ;
    :dependsOnPrevalence true ;
    :hasAggregationOperator :AggOp_AbsoluteDifference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Transforming ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Useful only if positivity rate matters in context; relevance depends on chosen threshold."@en ;
    :hasImplementation :impl_AIF360_statistical_parity_difference,
        :impl_Fairlearn_demographic_parity_difference ;
    :hasMatchingMetric roadmap:03228 ;
    :hasPerformanceDependence :00087 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_SensitiveAttribute .

:AUPRC a owl:NamedIndividual,
        :StandardMetric ;
    rdfs:label "area under the precision-recall curve"@en ;
