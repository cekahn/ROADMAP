:00034 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "censoring-based group fairness"@en ;
    dcterms:source <https://doi.org/10.1145/3534678.3539259> ;
    skos:definition "Extends group fairness by incorporating censoring information, comparing survival-probability estimates between censored and uncensored individuals with similar features within groups."@en ;
    :dependsOnPrevalence true ;
    :hasAggregationOperator :AggOp_Mean ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Transforming ;
