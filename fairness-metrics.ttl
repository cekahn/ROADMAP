:00044 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "equal calibration"@en ;
    dcterms:source <https://doi.org/10.48550/arXiv.1609.05807> ;
    skos:altLabel "matching conditional frequencies"@en,
        "test-fairness"@en ;
    skos:definition "Also known as test-fairness or matching conditional frequencies; requires that, for any estimated probability value, groups have similar positivity rates in the ground truth."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_AbsoluteDifference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Unclear how to operationalise across thresholds; satisfying equal calibration is in principle desirable."@en ;
    :hasMetricSubtype :Calibration ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric roadmap:03655 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00068 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "recall equality difference"@en ;
    dcterms:source <https://doi.org/10.1145/3593013.3593982> ;
    skos:definition "Measures the average absolute difference in recall (true positive rate) between each group and the overall recall; a multi-group extension of the equal opportunity difference."@en ;
    :dependsOnPrevalence false ;
    :hasAggregationOperator :AggOp_Mean ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00089 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Same considerations as equal opportunity difference."@en ;
    :hasMatchingMetric roadmap:03227 ;
    :hasMetricSubtype :Partial ;
    :hasPerformanceDependence :00086 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_MultiGroup ;
    :hasTargetValue "0" ;
    :proposedForHealthcare true ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:00080 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "well calibration"@en ;
    dcterms:source <https://doi.org/10.1145/3616865> ;
    skos:definition "An extension of equal calibration requiring that the actual probability of being in the positive class match not only the estimated probability across all groups but also a target probability."@en ;
    :dependsOnPrevalence true ;
    :hasAggregationOperator :AggOp_Difference ;
    :hasBiasPreservationProperty :BiasPreservationProperty_Preserving ;
    :hasEvaluationLevel :00088 ;
    :hasFairnessDirection :FairnessDirection_Lower ;
    :hasFairnessLevel :GroupFairness ;
    :hasGuidanceLevel :UseWithCaution ;
    :hasGuidanceRationale "Vaguely defined in the literature."@en ;
    :hasMetricSubtype :Calibration ;
    :hasPerformanceDependence :00086 ;
    :hasRelatedMetric roadmap:03655 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel,
        :Input_SensitiveAttribute .

:AggOp_StandardDeviation a owl:NamedIndividual,
        :AggregationOperator ;
    rdfs:label "standard deviation"@en ;
    skos:definition "The standard deviation of a base metric across groups."@en .

:BiasPreservationProperty a owl:Class ;
    rdfs:label "bias preservation property"@en ;
    dcterms:source <https://doi.org/10.2139/ssrn.3792772> ;
    rdfs:subClassOf :00084 ;
    skos:definition "Whether a fairness metric is bias-preserving (accepts the status quo / historical outcome labels as a valid reference) or bias-transforming (aims for substantive equality and challenges potentially biased historical labels)."@en .

:ECE a owl:NamedIndividual,
        :StandardMetric ;
    rdfs:label "expected calibration error"@en ;
    dcterms:source <https://doi.org/10.17605/OSF.IO/Z83ND> ;
    skos:altLabel "ECE"@en ;
    skos:definition "The weighted average, across probability bins, of the absolute difference between the observed accuracy and the mean estimated probability within each bin; a value of 0 denotes perfect calibration."@en ;
    :hasEvaluationLevel :00088 ;
    :hasMatchingMetric roadmap:03332 ;
    :hasScoringPropriety :Propriety_Proper ;
    :requiresInput :Input_EstimatedProbability,
        :Input_OutcomeLabel .

:FPR a owl:NamedIndividual,
        :StandardMetric ;
    rdfs:label "false positive rate"@en ;
    dcterms:source <https://doi.org/10.17605/OSF.IO/Z83ND> ;
    skos:definition "The proportion of instances with a negative outcome that are incorrectly predicted positive."@en ;
    :hasEvaluationLevel :00089 ;
    :hasImplementation :impl_Fairlearn_false_positive_rate ;
    :hasMatchingMetric roadmap:03322 ;
    :hasScoringPropriety :Propriety_Improper ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel .

:NPV a owl:NamedIndividual,
        :StandardMetric ;
    rdfs:label "negative predictive value"@en ;
    dcterms:source <https://doi.org/10.17605/OSF.IO/Z83ND> ;
    skos:definition "The proportion of instances predicted negative that actually have a negative outcome."@en ;
    :hasEvaluationLevel :00089 ;
    :hasMatchingMetric roadmap:03325 ;
    :hasScoringPropriety :Propriety_Improper ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel .

:PPV a owl:NamedIndividual,
        :StandardMetric ;
    rdfs:label "positive predictive value"@en ;
    dcterms:source <https://doi.org/10.17605/OSF.IO/Z83ND> ;
    skos:altLabel "precision"@en ;
    skos:definition "The proportion of instances predicted positive that actually have a positive outcome."@en ;
    :hasEvaluationLevel :00089 ;
    :hasImplementation :impl_Fairlearn_positive_predictive_value ;
    :hasMatchingMetric roadmap:03324 ;
    :hasScoringPropriety :Propriety_Improper ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_OutcomeLabel .

:Propriety_Proper a owl:NamedIndividual,
        :ScoringPropriety ;
    rdfs:label "proper"@en ;
    skos:definition "A metric whose expected value is optimised only by the correct model."@en .

