        :impl_Fairlearn_demographic_parity_ratio ;
    :hasPerformanceDependence :00087 ;
    :hasRelatedMetric roadmap:03228 ;
    :hasSupportedSensitiveAttributeType :SensitiveAttributeType_Binary ;
    :hasTargetValue "0 (< 0.2)" ;
    :proposedForHealthcare false ;
    :requiresInput :Input_DecisionThreshold,
        :Input_EstimatedProbability,
        :Input_SensitiveAttribute .

:00043 a owl:NamedIndividual,
        :00023 ;
    rdfs:label "earth mover’s distance for equivalent separation"@en ;
    dcterms:source <https://doi.org/10.1145/3306618.3314278> ;
    skos:definition "Uses the first Wasserstein (earth mover's) distance to quantify how far apart the distributions of estimated probabilities are between sensitive groups within each outcome stratum, enforcing a separation criterion across all thresholds."@en ;
    :dependsOnPrevalence true ;
