:Gender a owl:Class ;
    rdfs:label "gender"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    rdfs:comment "Coded with the SNOMED CT gender-identity value set used by US Core / the HL7 Gender Harmony project; the associated LOINC question code is 76691-5."@en ;
    rdfs:seeAlso <https://loinc.org/76691-5>,
        <https://www.healthit.gov/isp/uscdi-data/gender-identity> ;
    rdfs:subClassOf :SensitiveAttribute ;
    skos:definition "Gender identity of the individual, as distinct from sex."@en ;
    :loincQuestionCode "76691-5"^^xsd:string ;
    :uscdiDataElement "Gender Identity (USCDI v3)"^^xsd:string .

:Overall a owl:NamedIndividual,
