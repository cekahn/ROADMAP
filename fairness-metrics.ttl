:Race a owl:Class ;
    rdfs:label "race"@en ;
    dcterms:source <https://doi.org/10.1016/j.landig.2026.101001> ;
    rdfs:comment "Coded values follow the OMB Statistical Policy Directive 15 (1997) categories as encoded by CDCREC and used by FHIR US Core. Note: OMB revised SPD 15 in March 2024 to collect race and ethnicity via a single combined question and to add 'Middle Eastern or North African' as a minimum category; those revisions are still being adopted in FHIR."@en,
        "SNOMED CT provides a 'Racial group' hierarchy (root 415229000) for detailed coding, but it does not map one-to-one to the OMB minimum categories, so the OMB-category values here are coded with CDCREC rather than SNOMED."@en ;
    rdfs:seeAlso <http://hl7.org/fhir/us/core/ValueSet/omb-race-category>,
        <http://snomed.info/id/415229000>,
        <https://loinc.org/32624-9> ;
    rdfs:subClassOf :SensitiveAttribute ;
    skos:definition "Race of the individual, as distinct from ethnicity."@en ;
    :loincQuestionCode "32624-9"^^xsd:string ;
    :uscdiDataElement "Race (USCDI v3)"^^xsd:string .

:SoftwareToolkit a owl:Class ;
    rdfs:label "software toolkit"@en ;
    skos:definition "A software library that implements fairness or performance metrics."@en .

:AggOp_Maximum a owl:NamedIndividual,
        :AggregationOperator ;
    rdfs:label "maximum"@en ;
    skos:definition "The maximum deviation across groups or group pairs (worst-case)."@en .

:Calibration a owl:NamedIndividual,
        :MetricSubtype ;
    rdfs:label "calibration"@en .

:CodeSystem a owl:Class ;
    rdfs:label "code system"@en ;
