    skos:definition "An inequality index applied to per-group benefits."@en .

:AggOp_LogRatio a owl:NamedIndividual,
        :AggregationOperator ;
    rdfs:label "log ratio"@en ;
    skos:definition "The logarithm of the ratio of group values."@en .

:AggOp_Minimum a owl:NamedIndividual,
        :AggregationOperator ;
    rdfs:label "minimum"@en ;
    skos:definition "The minimum of a base metric across groups (worst-group value)."@en .

:AggOp_WassersteinDistance a owl:NamedIndividual,
        :AggregationOperator ;
    rdfs:label "Wasserstein distance"@en ;
    skos:definition "The first Wasserstein (earth mover's) distance between per-group distributions."@en .

